# OpenSOP environment configuration — copy to `.env` and fill in real values.
# Anything committed here MUST be a placeholder. Real secrets live in your
# deployment's secret manager (Fly secrets, Kamal secrets, GCP Secret Manager,
# Kubernetes Secrets, etc.) and never in source control.

# ────────────────────────────────────────────────────────────────────────────
# Rails
# ────────────────────────────────────────────────────────────────────────────

# Decryption key for `config/credentials.yml.enc`. In production this is
# typically injected via your platform's secret store, NOT this file.
# Generate locally with: bin/rails credentials:edit
RAILS_MASTER_KEY=

# Log verbosity in production. One of: debug | info | warn | error | fatal.
RAILS_LOG_LEVEL=info

# Puma tuning. Defaults are fine for local dev.
PORT=3000
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=

# Run Solid Queue inside the Puma process (no separate worker container).
# Accepts: true | 1 | yes | on. Anything else (including blank) = off.
SOLID_QUEUE_IN_PUMA=

# Per-worker concurrency for Solid Queue when running as a standalone process.
JOB_CONCURRENCY=

# ────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ────────────────────────────────────────────────────────────────────────────

# Either set DATABASE_URL OR set OPENSOP_DATABASE_PASSWORD (host/db come from
# config/database.yml). DATABASE_URL takes precedence.
DATABASE_URL=postgres://opensop:CHANGE_ME@localhost:5432/opensop_development
OPENSOP_DATABASE_PASSWORD=

# Solid Cache / Solid Queue use separate databases in production.
CACHE_DATABASE_URL=
QUEUE_DATABASE_URL=

# ────────────────────────────────────────────────────────────────────────────
# OpenSOP API auth
# ────────────────────────────────────────────────────────────────────────────

# Bearer token for the public REST API (sent as `X-SOP-Token` header).
# When unset in production the API fails closed (returns 503). Generate with:
#   ruby -e 'require "securerandom"; puts SecureRandom.hex(32)'
OPENSOP_API_TOKEN=

# Public base URL of this OpenSOP instance — used to build callback URLs
# the runtime hands to webhook steps. No trailing slash.
OPENSOP_BASE_URL=http://localhost:3000

# HTTP basic auth on the /ui admin pages. Leave both blank in dev to disable.
# Set both in production — the UI does NOT enforce auth on its own.
OPENSOP_UI_USER=
OPENSOP_UI_PASSWORD=

# ────────────────────────────────────────────────────────────────────────────
# LLM provider (required only for processes with `judgment` or `llm` steps)
# ────────────────────────────────────────────────────────────────────────────

# Anthropic API key. Required for the default judgment/LLM step executor.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
