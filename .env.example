# OpenSOP environment configuration — copy to `.env` and fill in real values.
# Anything committed here MUST be a placeholder. Real secrets live in your
# deployment's secret manager (Fly secrets, Kamal secrets, GCP Secret Manager,
# Kubernetes Secrets, etc.) and never in source control.

# ────────────────────────────────────────────────────────────────────────────
# Rails
# ────────────────────────────────────────────────────────────────────────────

# Decryption key for `config/credentials.yml.enc`. In production this is
# typically injected via your platform's secret store, NOT this file.
# Generate locally with: bin/rails credentials:edit
RAILS_MASTER_KEY=

# Log verbosity in production. One of: debug | info | warn | error | fatal.
RAILS_LOG_LEVEL=info

# Comma-separated list of hosts the app will accept in production
# (matched against the Host header). Required when running behind a custom
# domain or subdomain. Leave unset locally — dev/test allow all hosts.
# Example: "opensop.example.com,www.opensop.example.com"
RAILS_ALLOWED_HOSTS=

# Puma tuning. Defaults are fine for local dev.
PORT=3000
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=

# Run Solid Queue inside the Puma process (no separate worker container).
# Accepts: true | 1 | yes | on. Anything else (including blank) = off.
SOLID_QUEUE_IN_PUMA=

# Per-worker concurrency for Solid Queue when running as a standalone process.
JOB_CONCURRENCY=

# ────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ────────────────────────────────────────────────────────────────────────────

# Either set DATABASE_URL OR set OPENSOP_DATABASE_PASSWORD (host/db come from
# config/database.yml). DATABASE_URL takes precedence.
DATABASE_URL=postgres://opensop:CHANGE_ME@localhost:5432/opensop_development
OPENSOP_DATABASE_PASSWORD=

# Solid Cache / Solid Queue use separate databases in production.
CACHE_DATABASE_URL=
QUEUE_DATABASE_URL=

# ────────────────────────────────────────────────────────────────────────────
# OpenSOP API auth
# ────────────────────────────────────────────────────────────────────────────

# Bearer token for the public REST API (sent as `X-SOP-Token` header).
# When unset in production the API fails closed (returns 503). Generate with:
#   ruby -e 'require "securerandom"; puts SecureRandom.hex(32)'
OPENSOP_API_TOKEN=

# Public base URL of this OpenSOP instance — used to build callback URLs
# the runtime hands to webhook steps. No trailing slash.
OPENSOP_BASE_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────────
# Admin UI auth (passkeys / WebAuthn)
# ────────────────────────────────────────────────────────────────────────────

# WebAuthn relying-party ID — the apex domain of this deployment.
# In production this MUST match the host browsers see (no protocol, no port).
# In dev, "localhost" is the default.
OPENSOP_RP_ID=localhost

# Full origin URL used to validate WebAuthn ceremonies. Must include scheme
# and (if non-default) port. In production this MUST be set.
OPENSOP_ORIGIN=http://localhost:3000

# Display name shown to users during passkey registration prompts.
OPENSOP_RP_NAME=OpenSOP

# First-run bootstrap: when the database has zero User rows AND this is set,
# OpenSOP creates the first admin and prints a one-time invitation URL to
# the logs and tmp/opensop_first_login.txt. Ignored once any User exists.
OPENSOP_BOOTSTRAP_EMAIL=

# ────────────────────────────────────────────────────────────────────────────
# Email delivery (Resend) — required for magic-link sign-in and invitations
# ────────────────────────────────────────────────────────────────────────────

# Resend API key. Get one at https://resend.com/.
RESEND_API_KEY=

# From address for auth emails, e.g. "OpenSOP <noreply@your-domain>".
OPENSOP_MAILER_FROM=

# Delivery mode. `send` calls Resend; `log` writes the email to
# tmp/opensop_emails/ and Rails.logger.info instead. Defaults to `send`
# in production and `log` in dev/test.
OPENSOP_MAILER_MODE=

# Resend template aliases. Both default to the OpenSOP-published templates
# (created in the Resend dashboard with these aliases). Override if you fork
# the templates under different names in your own Resend account.
OPENSOP_RESEND_TEMPLATE_MAGIC_LINK=opensop-magic-link
OPENSOP_RESEND_TEMPLATE_INVITATION=opensop-invitation

# ────────────────────────────────────────────────────────────────────────────
# LLM provider (required only for processes with `judgment` or `llm` steps)
# ────────────────────────────────────────────────────────────────────────────

# Anthropic API key. Required for the default judgment/LLM step executor.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
