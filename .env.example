# ==============================================================================
#  OpenSOP — environment configuration
# ==============================================================================
#
# Copy this file to .env and fill in the marked values.
# After editing: docker compose up -d
#
# For a guided install, ask your AI agent to follow INSTALL_FOR_AGENTS.md,
# or follow the step-by-step instructions in INSTALL.md.
#
# .env is listed in .gitignore — do NOT commit it. Real secrets belong in your
# deployment's secret manager (Fly secrets, Kamal secrets, GCP Secret Manager,
# Kubernetes Secrets, etc.).

# ------------------------------------------------------------------------------
# REQUIRED — must be set for every mode, including local-dev
# ------------------------------------------------------------------------------

# Encrypts config/credentials.yml.enc at rest.
# Generate with: openssl rand -hex 32
# IMPORTANT: after generating a new value you must also delete
# config/credentials.yml.enc and regenerate it:
#   rm config/credentials.yml.enc
#   RAILS_MASTER_KEY=<value> EDITOR=true bin/rails credentials:edit
# See INSTALL.md §4 for the full procedure.
RAILS_MASTER_KEY=

# Signs and verifies session cookies.
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Bearer token for the OpenSOP REST API (X-SOP-Token header).
# When unset in production the API fails closed (returns 503).
# Generate with: openssl rand -hex 32
OPENSOP_API_TOKEN=

# PostgreSQL credentials — internal to the compose network.
POSTGRES_USER=opensop
POSTGRES_PASSWORD=
POSTGRES_DB=opensop_production

# Host port that OpenSOP binds on the Docker host. Change if 3000 is taken.
OPENSOP_PORT=3000

# ------------------------------------------------------------------------------
# MODE — adjust these values based on your deploy target.
#
#   local-dev:        RAILS_ENV=development, all URLs → localhost
#   self-host-local:  RAILS_ENV=production,  all URLs → localhost
#   self-host-public: RAILS_ENV=production,  all URLs → your real domain
#
# See INSTALL.md for the full mode guide.
# ------------------------------------------------------------------------------

RAILS_ENV=production

# Rails log verbosity: debug | info | warn | error | fatal
RAILS_LOG_LEVEL=info

# Comma-separated Host headers Rails will accept.
# For self-host-public, set to your domain: opensop.acme.com
RAILS_ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL of this instance — used to build webhook callback URLs.
# No trailing slash.
# For self-host-public: https://opensop.acme.com
OPENSOP_BASE_URL=http://localhost:3000

# WebAuthn relying-party ID — the apex domain browsers see (no scheme/port).
# For self-host-public: opensop.acme.com
OPENSOP_RP_ID=localhost

# WebAuthn origin — must exactly match the browser origin during sign-in.
# For self-host-public: https://opensop.acme.com
OPENSOP_ORIGIN=http://localhost:3000

# Display name shown in passkey registration dialogs.
OPENSOP_RP_NAME=OpenSOP

# Run Solid Queue inline inside Puma. Set to false only if you add a dedicated
# worker: service in a docker-compose.override.yml at high throughput.
SOLID_QUEUE_IN_PUMA=true

# ------------------------------------------------------------------------------
# FIRST ADMIN — set once for first boot, ignored after any user exists
# ------------------------------------------------------------------------------

# Creates a bootstrap admin account on first boot.
# After the first user registers, this env var has no effect.
OPENSOP_BOOTSTRAP_EMAIL=

# DANGER — disable the admin UI login entirely. When truthy (true/1/yes/on)
# the UI auto-authenticates as the bootstrap admin with no passkey, so anyone
# who can reach the server has full admin access. Intended ONLY for local
# development or a trusted single-machine self-host.
#
# Guarded: it is IGNORED on public deployments — if OPENSOP_RP_ID is a real
# domain (anything other than localhost / 127.0.0.1) the login stays enforced.
# When active, a boot warning is logged and a red banner shows in the UI.
# Leave blank/unset for normal, secure operation.
# OPENSOP_DISABLE_AUTH=

# ------------------------------------------------------------------------------
# OPTIONAL — magic-link email sign-in (passkeys-only is the default)
#
# Skip this section if you only need passkey (WebAuthn) sign-in.
# Requires a Resend account: https://resend.com
# ------------------------------------------------------------------------------

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From address for auth emails.
# OPENSOP_MAILER_FROM=OpenSOP <noreply@yourdomain.com>

# "send" calls Resend; "log" writes the email body to Rails logs instead.
# Default is "log" — change to "send" when RESEND_API_KEY is configured.
OPENSOP_MAILER_MODE=log

# Resend template aliases. Override only if you fork the templates.
OPENSOP_RESEND_TEMPLATE_MAGIC_LINK=opensop-magic-link
OPENSOP_RESEND_TEMPLATE_INVITATION=opensop-invitation

# ------------------------------------------------------------------------------
# OPTIONAL — LLM provider for `judgment` step type
#
# Skip this section if your processes do not use `judgment` steps.
# Without a key, judgment steps pause as "escalated" and wait for a human to
# submit a decision via POST .../steps/:step_id/submit.
#
# Currently supported: Anthropic Claude.
# Get a key at: https://console.anthropic.com/
# ------------------------------------------------------------------------------

# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# PLATFORM DEPLOYS — additional variables for Kamal / Fly / GCP Cloud Run
# (not used by the Docker Compose self-host path above)
# ------------------------------------------------------------------------------

# Direct DATABASE_URL override — takes precedence over POSTGRES_* variables.
# Use for managed databases (RDS, Cloud SQL, Fly Postgres, etc.).
# DATABASE_URL=postgres://opensop:password@host:5432/opensop_production

# Separate Solid Cache and Solid Queue database URLs. The Docker Compose path
# sets these automatically (to dedicated databases on the same Postgres). They
# are NOT optional: Solid Cache and Solid Queue each require their own logical
# database — leaving them blank makes those connections fall back to a local
# socket and the app will fail to boot. Only set them by hand for a non-compose
# deploy where the cache/queue databases live somewhere other than DATABASE_URL.
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=

# Per-worker concurrency for a standalone Solid Queue worker process.
# JOB_CONCURRENCY=
