<% case variant %>
<% when :completed %>
  <svg class="h-4 w-4 <%= color_class %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 8.25l3 3 6-6.5" />
  </svg>
<% when :failed %>
  <svg class="h-4 w-4 <%= color_class %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M5.75 5.75l4.5 4.5M10.25 5.75l-4.5 4.5" />
  </svg>
<% when :skipped %>
  <svg class="h-4 w-4 <%= color_class %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h6" />
  </svg>
<% when :waiting %>
  <svg class="h-4 w-4 <%= color_class %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 4.5V8l2.25 1.5" />
  </svg>
<% when :warning %>
  <svg class="h-4 w-4 <%= color_class %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 2.5l6 11H2l6-11z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 6.5v3M8 11.5h.01" />
  </svg>
<% when :running %>
  <svg class="h-4 w-4 <%= color_class %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" />
    <circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none" />
  </svg>
<% else %>
  <svg class="h-4 w-4 <%= color_class %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" />
  </svg>
<% end %>
