<%# Callout component — colored left-border block for AUTH/PREREQ/IMPORTANT notices %>
<div class="flex items-start gap-2 rounded-r-[3px] p-3 pl-4 <%= variant_classes %>">
  <% if label.present? %>
    <span class="font-mono text-[10px] font-bold uppercase shrink-0 <%= label_color_class %>"><%= label %></span>
    <span class="text-[#5d6470] text-[13px]">—</span>
  <% end %>
  <div class="text-[13px] text-[#5d6470] flex-1">
    <%= body %>
  </div>
</div>
