<% if empty? %>
  <div class="rounded-[3px] border border-border bg-bg-sunken p-4 text-center text-[12px] text-fg-muted"><%= t('opensop.common.empty_state') %></div>
<% else %>
  <div class="rounded-[3px] border border-border bg-bg overflow-hidden">
    <% fields.each do |field| %>
      <div class="grid grid-cols-[200px_1fr] gap-3 px-4 py-2 border-b border-border last:border-b-0">
        <div class="min-w-0">
          <div class="font-mono text-[12px] text-fg truncate"><%= field_name(field) %></div>
          <div class="font-mono text-[10px] text-fg-faint"><%= field_type(field) %><%= required?(field) ? " · required" : "" %></div>
        </div>
        <div class="min-w-0">
          <% if field_description(field).present? %>
            <p class="text-[12px] text-fg-muted"><%= field_description(field) %></p>
          <% end %>
          <% if field_values(field).present? %>
            <div class="mt-1 flex flex-wrap gap-1">
              <% Array(field_values(field)).each do |v| %>
                <span class="pp-tag"><%= v %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
