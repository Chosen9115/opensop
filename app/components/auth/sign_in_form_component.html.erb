<div class="rounded-md border border-border bg-bg p-6">
  <h1 class="text-lg font-semibold text-fg"><%= t("opensop.auth.sign_in.heading") %></h1>
  <p class="mt-1 text-[13px] text-fg-muted"><%= t("opensop.auth.sign_in.description") %></p>

  <%= form_with url: auth_magic_links_path,
                method: :post,
                local: true,
                class: "mt-5",
                data: {
                  turbo: false,
                  controller: "passkey-signin",
                  "passkey-signin-options-url-value": auth_passkey_options_path,
                  "passkey-signin-verify-url-value": auth_passkey_verify_path,
                  "passkey-signin-generic-error-text": t("opensop.auth.sign_in.generic_error"),
                  "passkey-signin-email-required-text": t("opensop.auth.sign_in.email_required")
                } do %>
    <%= hidden_field_tag :return_to, return_to %>
    <%= hidden_field_tag :purpose, "sign_in" %>

    <%# Email field block %>
    <div class="mb-1.5 flex items-center justify-between font-mono text-[10px] uppercase tracking-wider">
      <label class="text-fg-muted" for="email"><%= t("opensop.auth.sign_in.email_label") %></label>
      <span class="text-red-700"><%= t("opensop.auth.sign_in.email_required_pill") %></span>
    </div>
    <%= email_field_tag :email, nil,
          autocomplete: "username webauthn",
          autofocus: true,
          required: true,
          placeholder: t("opensop.auth.sign_in.email_placeholder"),
          data: { "passkey-signin-target": "email" },
          class: "w-full rounded border border-border bg-bg-sunken px-3 py-2 text-[13px] text-fg placeholder:text-fg-faint focus:outline-none focus:ring-2 focus:ring-fg" %>
    <p class="mt-2 text-[12px] text-fg-faint"><%= t("opensop.auth.sign_in.privacy_note") %></p>

    <%# Primary CTA — passkey %>
    <button type="button"
            class="mt-4 w-full inline-flex items-center justify-center gap-2 rounded bg-fg text-bg px-4 py-2 text-[13px] font-medium hover:bg-fg-muted disabled:opacity-60 disabled:cursor-not-allowed cursor-pointer"
            data-action="passkey-signin#submit"
            data-passkey-signin-target="submit"
            data-testid="passkey-signin-button">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
      </svg>
      <span class="flex-1 text-center"><%= t("opensop.auth.sign_in.passkey_cta") %></span>
      <kbd class="font-mono text-[11px] opacity-70"><%= t("opensop.auth.sign_in.kbd_hint") %></kbd>
    </button>

    <%# OR divider %>
    <div class="my-4 flex items-center gap-3">
      <span class="h-px flex-1 bg-border"></span>
      <span class="font-mono text-[10px] uppercase tracking-wider text-fg-faint"><%= t("opensop.auth.sign_in.or") %></span>
      <span class="h-px flex-1 bg-border"></span>
    </div>

    <%# Secondary CTA — magic link %>
    <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded border border-border bg-bg text-fg px-4 py-2 text-[13px] font-medium hover:border-border-strong cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
      </svg>
      <%= t("opensop.auth.sign_in.magic_link_cta") %>
    </button>

    <div data-passkey-signin-target="error"
         class="hidden mt-3 rounded border border-red-200 bg-red-50 px-3 py-2 text-[12px] text-red-700"
         role="alert"
         aria-live="polite"></div>

    <div data-passkey-fallback
         class="hidden mt-3 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-[12px] text-amber-800">
      <%= t("opensop.auth.sign_in.fallback_no_webauthn") %>
    </div>
  <% end %>

  <details class="group mt-5 border-t border-border pt-4">
    <summary class="flex cursor-pointer items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-fg-faint hover:text-fg-muted list-none [&::-webkit-details-marker]:hidden">
      <svg class="h-3 w-3 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
      <span><%= t("opensop.auth.sign_in.recovery_link") %></span>
    </summary>
    <%= form_with url: auth_magic_links_path, method: :post, local: true, class: "mt-3", data: { turbo: false } do %>
      <%= hidden_field_tag :purpose, "recovery" %>
      <label class="mb-1.5 block font-mono text-[10px] uppercase tracking-wider text-fg-muted" for="recovery_email">
        <%= t("opensop.auth.sign_in.email_label") %>
      </label>
      <%= email_field_tag :email, nil,
            id: "recovery_email",
            required: true,
            placeholder: t("opensop.auth.sign_in.email_placeholder"),
            class: "mb-3 w-full rounded border border-border bg-bg-sunken px-3 py-2 text-[13px] text-fg placeholder:text-fg-faint focus:outline-none focus:ring-2 focus:ring-fg" %>
      <button type="submit"
              class="w-full rounded border border-border bg-bg px-4 py-2 text-[13px] font-medium text-fg hover:border-border-strong cursor-pointer">
        <%= t("opensop.auth.sign_in.recovery_cta") %>
      </button>
    <% end %>
  </details>
</div>
