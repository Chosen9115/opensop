<header class="border-b border-border bg-bg">
  <div class="mx-auto flex w-full max-w-[1200px] items-center gap-3 px-6 py-3">
    <%# Brand block — mirrors SidebarComponent %>
    <div class="flex items-center gap-2.5 text-[14px] font-semibold tracking-tight text-fg">
      <div class="grid h-[18px] w-[18px] grid-cols-2 grid-rows-2 gap-[2px]">
        <div class="rounded-[1px] bg-fg"></div>
        <div class="rounded-[1px] bg-fg-muted"></div>
        <div class="rounded-[1px] bg-fg-muted"></div>
        <div class="rounded-[1px] bg-fg"></div>
      </div>
      <span><%= I18n.t("opensop.app.name") %></span>
      <span class="pp-tag"><%= version_label %></span>
    </div>

    <%# Right-side nav links %>
    <nav class="ml-auto flex items-center gap-5 font-mono text-[11px] uppercase tracking-wider">
      <%= link_to I18n.t("opensop.auth.sign_in.topbar.docs", default: "Docs"),
            "/api-docs/",
            class: "text-fg-muted hover:text-fg" %>
      <span class="text-fg-faint cursor-not-allowed" aria-disabled="true">
        <%= I18n.t("opensop.auth.sign_in.topbar.status", default: "Status") %>
      </span>
      <span class="text-fg-faint cursor-not-allowed" aria-disabled="true">
        <%= I18n.t("opensop.auth.sign_in.topbar.contact", default: "Contact") %>
      </span>
    </nav>
  </div>
</header>
