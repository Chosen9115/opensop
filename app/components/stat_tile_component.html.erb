<div class="rounded-lg bg-white border border-slate-200 border-t-4 <%= top_border_class %> shadow-sm px-5 py-4" <% if hint.present? %>title="<%= hint %>"<% end %>>
  <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= label %></p>
  <p class="mt-2 text-3xl font-semibold tabular-nums <%= value_class %>"><%= value %></p>
</div>
