<div class="relative rounded-[3px] border border-border bg-bg p-4" <% if hint.present? %>title="<%= hint %>"<% end %>>
  <div class="pp-section-title"><%= label %></div>
  <div class="mt-2 text-[28px] font-semibold tabular-nums text-fg leading-none"><%= value %></div>
  <% if hint.present? %>
    <p class="mt-2 text-[11px] text-fg-faint"><%= hint %></p>
  <% end %>
  <% if show_dot? %>
    <span class="absolute top-3 right-3 h-1.5 w-1.5 rounded-full <%= tone_dot_class %>"></span>
  <% end %>
</div>
