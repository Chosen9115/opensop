<aside class="flex flex-col gap-1 overflow-y-auto border-r border-border bg-bg-sunken px-3 py-4 w-[220px]">
  <%# Brand block %>
  <div class="flex items-center gap-2.5 px-2 pb-4 pt-1 text-[14px] font-semibold tracking-tight">
    <div class="grid h-[18px] w-[18px] grid-cols-2 grid-rows-2 gap-[2px]">
      <div class="rounded-[1px] bg-fg"></div>
      <div class="rounded-[1px] bg-fg-muted"></div>
      <div class="rounded-[1px] bg-fg-muted"></div>
      <div class="rounded-[1px] bg-fg"></div>
    </div>
    <span>OpenSOP</span>
    <span class="pp-tag ml-auto"><%= version_label %></span>
  </div>

  <%# Search prompt %>
  <button type="button"
          data-action="click->cmdk#open"
          class="mb-2 flex items-center gap-1.5 rounded-[3px] border border-border bg-bg px-2.5 py-1.5 font-mono text-[11px] text-fg-muted hover:border-border-strong cursor-pointer">
    <svg class="shrink-0" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="<%= icon_path(:search) %>" />
    </svg>
    <span><%= I18n.t("opensop.nav.jump_to_anything", default: "Jump to anything…") %></span>
    <kbd class="ml-auto rounded-[2px] bg-bg-pill px-[5px] py-[1px] font-mono text-[10px]">⌘K</kbd>
  </button>

  <%# Workspace section %>
  <div class="pp-section-title px-2 pt-3 pb-1"><%= I18n.t("opensop.nav.workspace", default: "Workspace") %></div>
  <% workspace_items.each do |item| %>
    <% if item[:disabled] %>
      <div class="<%= link_classes(item) %>" title="<%= coming_soon_title %>">
        <svg class="shrink-0" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="<%= icon_path(item[:icon]) %>" />
        </svg>
        <span class="flex-1 truncate"><%= item[:label] %></span>
      </div>
    <% else %>
      <%= link_to item[:path], class: link_classes(item) do %>
        <svg class="shrink-0" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="<%= icon_path(item[:icon]) %>" />
        </svg>
        <span class="flex-1 truncate"><%= item[:label] %></span>
        <% if item[:badge].present? && item[:badge].to_i > 0 %>
          <span class="<%= badge_classes(item) %>"><%= item[:badge] %></span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# Library section %>
  <div class="pp-section-title px-2 pt-3 pb-1"><%= I18n.t("opensop.nav.library", default: "Library") %></div>
  <% library_items.each do |item| %>
    <% if item[:disabled] %>
      <div class="<%= link_classes(item) %>" title="<%= coming_soon_title %>">
        <svg class="shrink-0" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="<%= icon_path(item[:icon]) %>" />
        </svg>
        <span class="flex-1 truncate"><%= item[:label] %></span>
      </div>
    <% else %>
      <%= link_to item[:path], class: link_classes(item) do %>
        <svg class="shrink-0" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="<%= icon_path(item[:icon]) %>" />
        </svg>
        <span class="flex-1 truncate"><%= item[:label] %></span>
      <% end %>
    <% end %>
  <% end %>

  <%# Foot %>
  <div class="mt-auto flex flex-col gap-1.5 border-t border-border px-2 pt-3 font-mono text-[10px] text-fg-faint">
    <% if api_authenticated? %>
      <div class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-ok animate-pp-pulse"></span>
        <span class="text-ok"><%= I18n.t("opensop.sidebar.api_authenticated", default: "api · authenticated") %></span>
      </div>
    <% else %>
      <div class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-fg-faint"></span>
        <span><%= I18n.t("opensop.sidebar.api_no_token", default: "api · no token") %></span>
      </div>
    <% end %>
    <div><%= I18n.t("opensop.sidebar.workspace_label", name: "acme-prod", default: "workspace · acme-prod") %></div>
  </div>
</aside>
