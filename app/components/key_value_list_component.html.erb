<% if empty? %>
  <div class="rounded-[3px] border border-border bg-bg-sunken p-4 text-center text-[12px] text-fg-muted"><%= empty_label %></div>
<% else %>
  <div class="rounded-[3px] border border-border bg-bg overflow-hidden">
    <% entries.each do |key, value| %>
      <div class="grid grid-cols-[180px_1fr] gap-3 px-4 py-2 border-b border-border last:border-b-0 hover:bg-bg-hover">
        <div class="font-mono text-[11px] text-fg-muted break-all"><%= key %></div>
        <div class="min-w-0">
          <% if complex?(value) %>
            <details class="rounded-[3px] border border-border bg-bg-sunken overflow-hidden">
              <summary class="cursor-pointer select-none px-3 py-2 text-[11px] font-mono text-fg-muted hover:bg-bg-hover rounded-[3px]"><%= summary_label(value) %></summary>
              <pre class="font-mono text-[11px] text-fg bg-bg-sunken px-3 py-2 border-t border-border overflow-x-auto whitespace-pre"><%= format_value(value) %></pre>
            </details>
          <% else %>
            <div class="text-[12px] text-fg break-all"><%= format_value(value) %></div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
