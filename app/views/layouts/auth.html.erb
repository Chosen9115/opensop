<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <title><%= t("opensop.app.name") %> — <%= t("opensop.auth.sign_in.heading") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col bg-bg-sunken text-fg antialiased font-sans text-[13px] leading-[1.5]">
    <%= render Auth::TopbarComponent.new %>

    <main class="flex flex-1 items-center justify-center px-6 py-12">
      <div class="w-full max-w-md">
        <% if flash[:notice].present? || flash[:alert].present? %>
          <div class="mb-4">
            <%= render "shared/flash" %>
          </div>
        <% end %>

        <%# Breadcrumb pill above the card %>
        <div class="mb-4 flex justify-center">
          <span class="flex items-center gap-1.5 font-mono text-[11px] text-fg-faint">
            <span class="h-1 w-1 rounded-full bg-fg-faint"></span>
            <%= t("opensop.auth.sign_in.breadcrumb") %>
          </span>
        </div>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
