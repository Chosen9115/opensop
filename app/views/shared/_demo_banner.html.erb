<% if Opensop::DemoMode.enabled? %>
  <div class="sticky top-0 z-50 bg-warn-bg border-b border-warn text-warn">
    <div class="mx-auto max-w-[1200px] px-10 py-2 flex items-center justify-between gap-4 text-[12px]">
      <div class="flex items-center gap-2">
        <%# Heroicons exclamation-triangle mini 16x16 — inline SVG from heroicons.com %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 flex-shrink-0" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <span><%= t('opensop.demo.banner.message', schedule: Opensop::DemoMode::RESET_SCHEDULE_HUMAN) %></span>
      </div>
      <div class="flex items-center gap-3">
        <a href="https://github.com/Chosen9115/opensop"
           class="underline hover:no-underline font-medium"
           target="_blank"
           rel="noopener noreferrer">
          <%= t('opensop.demo.banner.github_link') %>
        </a>
      </div>
    </div>
  </div>
<% end %>
