<%# Command palette overlay. The `cmdk` Stimulus controller is mounted on
    <body> in the application layout so the sidebar's "Jump to anything…"
    trigger (and any other in-page trigger) is within its scope. The
    `data-cmdk-data-value` attribute lives on <body> as well — set there
    instead of here so the controller can read it on `connect`. %>
<%# backdrop %>
<div data-cmdk-target="backdrop"
     data-action="click->cmdk#close"
     class="hidden fixed inset-0 bg-fg/40 z-40"></div>
<%# dialog %>
<div data-cmdk-target="dialog"
     class="hidden fixed top-[20%] left-1/2 -translate-x-1/2 w-[520px] max-h-[60vh] flex flex-col rounded-[6px] border border-border bg-bg shadow-2xl z-50 overflow-hidden">
  <div class="flex items-center gap-2 border-b border-border px-3 py-2">
    <svg class="h-3.5 w-3.5 text-fg-faint" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <path d="M7 12a5 5 0 100-10 5 5 0 000 10z M11 11l3 3" />
    </svg>
    <input data-cmdk-target="input"
           data-action="input->cmdk#filter"
           placeholder="<%= I18n.t('opensop.cmdk.placeholder', default: 'Jump to a process, instance, action…') %>"
           class="flex-1 bg-transparent border-none outline-none text-[13px] placeholder:text-fg-faint focus:outline-none" />
  </div>
  <div data-cmdk-target="list" class="flex-1 overflow-y-auto"></div>
  <div class="flex items-center gap-3 border-t border-border bg-bg-sunken px-3 py-2 text-[10px] font-mono text-fg-faint">
    <span><kbd class="rounded-[2px] border border-border bg-bg px-1">↑↓</kbd> <%= I18n.t('opensop.cmdk.navigate', default: 'navigate') %></span>
    <span><kbd class="rounded-[2px] border border-border bg-bg px-1">↵</kbd> <%= I18n.t('opensop.cmdk.select', default: 'select') %></span>
    <span><kbd class="rounded-[2px] border border-border bg-bg px-1">esc</kbd> <%= I18n.t('opensop.cmdk.close', default: 'close') %></span>
  </div>
</div>
