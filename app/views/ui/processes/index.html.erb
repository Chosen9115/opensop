<%# Variant A — folder-tree Processes index. Two-column embedded layout: %>
<%# 240px tree on the left, fluid main on the right. %>
<div class="grid grid-cols-[240px_1fr] gap-6 -mx-10 -mt-8 min-h-[calc(100vh-2rem)]">
  <%# ── LEFT: TREE ────────────────────────────────────────────────── %>
  <aside class="border-r border-border bg-bg-sunken px-3 py-4 overflow-y-auto">
    <%= form_with url: ui_processes_path, method: :get, local: true, class: "mb-3" do %>
      <% if @dept %><%= hidden_field_tag :dept, @dept %><% end %>
      <% if @unit %><%= hidden_field_tag :unit, @unit %><% end %>
      <%= search_field_tag :q, @filter_q,
          placeholder: t('opensop.processes.tree.filter_placeholder'),
          class: "w-full rounded-[3px] border border-border bg-bg px-2 py-1 text-[11px] focus:border-border-focus focus:outline-none" %>
    <% end %>

    <ul class="space-y-0.5 text-[12px]">
      <li>
        <%= link_to ui_processes_path,
              class: "flex items-center gap-1.5 px-2 py-1 rounded-[3px] hover:bg-bg-hover #{'bg-bg-hover font-medium text-fg' if @dept.blank?}" do %>
          <span class="text-fg-faint">▾</span>
          <span class="font-medium"><%= t('opensop.processes.tree.all') %></span>
          <span class="ml-auto pp-tag"><%= @processes.size %></span>
        <% end %>
      </li>

      <% @tree.each do |dept_key, dept| %>
        <li>
          <%= link_to ui_processes_path(dept: dept_key),
                class: "flex items-center gap-1.5 px-2 py-1 rounded-[3px] hover:bg-bg-hover #{'bg-bg-hover font-medium text-fg' if @dept == dept_key && @unit.blank?}" do %>
            <span class="text-fg-faint"><%= @dept == dept_key ? '▾' : '▸' %></span>
            <span><%= dept[:name] %></span>
            <span class="ml-auto pp-tag"><%= dept[:count] %></span>
          <% end %>

          <% if @dept == dept_key %>
            <ul class="ml-4 mt-0.5 space-y-0.5">
              <% dept[:units].each do |unit_key, unit| %>
                <li>
                  <%= link_to ui_processes_path(dept: dept_key, unit: unit_key),
                        class: "flex items-center gap-1.5 px-2 py-1 rounded-[3px] hover:bg-bg-hover #{'bg-bg-hover font-medium text-fg' if @unit == unit_key}" do %>
                    <span class="text-fg-faint">›</span>
                    <span><%= unit[:name] %></span>
                    <span class="ml-auto pp-tag"><%= unit[:count] %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ul>

    <hr class="my-3 border-border" />
    <div class="pp-section-title px-2 mb-1"><%= t('opensop.processes.tree.pinned') %></div>
    <div class="px-2 py-1 text-fg-faint text-[11px]"><%= t('opensop.common.coming_soon') %></div>

    <hr class="my-3 border-border" />
    <div class="pp-section-title px-2 mb-1"><%= t('opensop.processes.tree.smart_views') %></div>
    <div class="px-2 py-1 text-fg-faint text-[11px]"><%= t('opensop.common.coming_soon') %></div>
  </aside>

  <%# ── RIGHT: MAIN ──────────────────────────────────────────────── %>
  <section class="px-2 py-4">
    <%# Breadcrumb %>
    <nav class="flex items-center gap-1.5 text-[11px] font-mono text-fg-muted mb-2">
      <%= link_to t('opensop.processes.tree.breadcrumb_root'), ui_processes_path, class: "hover:text-fg" %>
      <% if @dept %>
        <span class="text-fg-faint">/</span>
        <%= link_to @tree[@dept][:name], ui_processes_path(dept: @dept), class: "hover:text-fg" %>
      <% end %>
      <% if @unit %>
        <span class="text-fg-faint">/</span>
        <%= link_to @tree[@dept][:units][@unit][:name], ui_processes_path(dept: @dept, unit: @unit), class: "hover:text-fg" %>
      <% end %>
    </nav>

    <%# Title row %>
    <div class="flex items-baseline justify-between mb-6">
      <h1 class="text-[20px] font-semibold tracking-tight text-fg">
        <% if @unit %>
          <%= @tree[@dept][:units][@unit][:name] %>
        <% elsif @dept %>
          <%= @tree[@dept][:name] %>
        <% else %>
          <%= t('opensop.processes.tree.all') %>
        <% end %>
      </h1>
      <div class="flex items-center gap-4 text-[11px] font-mono text-fg-muted">
        <span>
          <b class="text-fg tabular-nums"><%= @summary[:count] %></b>
          <%= t('opensop.processes.summary.count_processes', count: @summary[:count]).sub(/\A\d+\s*/, '') %>
        </span>
        <span><%= t('opensop.processes.summary.in_flight_count', count: @summary[:in_flight]) %></span>
      </div>
    </div>

    <%# List %>
    <div class="border border-border rounded-[3px] divide-y divide-border bg-bg">
      <% if @visible.empty? %>
        <div class="p-8 text-center text-fg-muted text-[12px]"><%= t('opensop.processes.empty') %></div>
      <% end %>

      <% @visible.each do |process| %>
        <% defn = process.definition || {} %>
        <% pblock = defn["process"] || {} %>
        <% counts = @counts[process.name] || {} %>
        <% total_runs = counts[:total] || 0 %>
        <% in_flight = counts[:in_flight] || 0 %>
        <% prior_count = @prior_version_counts[process.name] || 0 %>
        <% tags = ((pblock["tags"] || process.tags || []))[0, 4] %>
        <% dept_label = process._dept %>
        <% unit_label = process._unit %>
        <%= link_to ui_process_path(name: process.name),
              class: "grid grid-cols-[1fr_140px_80px_80px_80px] items-center gap-4 px-4 py-2.5 hover:bg-bg-hover" do %>
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-mono text-[12px] text-fg truncate"><%= process.name %></span>
              <span class="font-mono text-[10px] text-fg-faint">v<%= process.version %></span>
              <% if prior_count > 0 %>
                <span class="font-mono text-[10px] text-fg-faint" title="<%= t('opensop.processes.list.prior_versions_title', count: prior_count) %>">· <%= t('opensop.processes.list.prior_versions', count: prior_count) %></span>
              <% end %>
            </div>
            <% if pblock["description"].present? %>
              <div class="text-[11px] text-fg-muted truncate mt-0.5"><%= pblock["description"] %></div>
            <% end %>
            <% if tags.any? %>
              <div class="flex gap-1 mt-1">
                <% tags.each do |tag| %>
                  <span class="pp-tag"><%= tag %></span>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="text-[10px] font-mono text-fg-muted truncate">
            <span class="text-fg-faint"><%= dept_label %></span>
            <span class="text-fg-faint"> › </span>
            <span><%= unit_label %></span>
          </div>

          <div class="text-right tabular-nums">
            <div class="text-[12px] font-medium text-fg">
              <%= total_runs %>
              <% if in_flight > 0 %>
                <span class="text-[9px] text-fg-muted font-normal">· <%= in_flight %> <%= t('opensop.processes.list.in_flight_label') %></span>
              <% end %>
            </div>
            <div class="text-[10px] text-fg-faint font-mono"><%= t('opensop.processes.list.total_runs_label') %></div>
          </div>

          <div class="text-right tabular-nums">
            <div class="text-[12px] font-medium text-fg">—</div>
            <div class="text-[10px] text-fg-faint font-mono"><%= t('opensop.processes.list.mtd_label') %></div>
          </div>

          <div class="text-right">
            <%= render PillComponent.new(state: process.status.to_s) %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
