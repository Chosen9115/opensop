<section class="mb-8 flex items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900"><%= t('opensop.processes.title') %></h1>
    <p class="mt-1 text-sm text-slate-600"><%= t('opensop.processes.subtitle') %></p>
  </div>

  <a href="#"
     aria-disabled="true"
     title="<%= t('opensop.common.coming_soon') %>"
     class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-400 cursor-not-allowed shadow-sm">
    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
    </svg>
    <%= t('opensop.nav.new_process') %>
  </a>
</section>

<% if @processes.any? %>
  <div class="grid grid-cols-1 gap-4">
    <% @processes.each do |process| %>
      <% defn   = process.definition || {} %>
      <% pblock = defn["process"] || {} %>
      <% steps_count = (pblock["steps"] || []).size %>
      <% owner       = pblock["owner"] || process.owner %>
      <% tags        = (pblock["tags"] || process.tags || []) %>
      <% sla         = pblock.dig("sla", "target") %>
      <% in_flight   = (@counts[process.name] || {})[:in_flight] || 0 %>
      <% completed   = (@counts[process.name] || {})[:completed] || 0 %>
      <% failed_ct   = (@counts[process.name] || {})[:failed] || 0 %>

      <article class="rounded-lg border border-slate-200 bg-white shadow-sm p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-base font-semibold text-slate-900">
                <%= link_to process.name, ui_process_path(name: process.name), class: "hover:text-indigo-600" %>
              </h2>
              <span class="text-xs text-slate-500 font-mono">v<%= process.version %></span>
              <%= render StateBadgeComponent.new(state: process.status, kind: :instance_state) %>
            </div>
            <% if pblock["description"].present? %>
              <p class="mt-1 text-sm text-slate-600"><%= pblock["description"] %></p>
            <% end %>

            <dl class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-slate-600">
              <div>
                <dt class="inline text-slate-500"><%= t('opensop.processes.table.steps') %>:</dt>
                <dd class="inline font-medium text-slate-900 ml-1 tabular-nums"><%= steps_count %></dd>
              </div>
              <div>
                <dt class="inline text-slate-500"><%= t('opensop.processes.table.owner') %>:</dt>
                <dd class="inline font-medium text-slate-900 ml-1"><%= owner.presence || t('opensop.common.none') %></dd>
              </div>
              <div>
                <dt class="inline text-slate-500"><%= t('opensop.processes.table.sla') %>:</dt>
                <dd class="inline font-medium text-slate-900 ml-1 tabular-nums"><%= sla.presence || "—" %></dd>
              </div>
              <div>
                <dt class="inline text-slate-500"><%= t('opensop.processes.table.in_flight') %>:</dt>
                <dd class="inline font-medium text-slate-900 ml-1 tabular-nums"><%= in_flight %></dd>
              </div>
            </dl>

            <% if tags.present? %>
              <div class="mt-3 flex flex-wrap gap-1.5">
                <% tags.each do |tag| %>
                  <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-medium text-slate-700"><%= tag %></span>
                <% end %>
              </div>
            <% end %>

            <p class="mt-3 text-xs text-slate-500">
              <%= t('opensop.processes.summary_line', in_flight: in_flight, completed: completed, failed: failed_ct) %>
            </p>
          </div>

          <div class="flex flex-col items-stretch gap-2 w-44 flex-shrink-0">
            <%= link_to ui_process_path(name: process.name),
                        class: "inline-flex justify-center items-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" do %>
              <%= t('opensop.common.view') %>
            <% end %>
            <%= link_to ui_instances_path(process: process.name),
                        class: "inline-flex justify-center items-center rounded-md border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" do %>
              <%= t('opensop.processes.show.view_instances') %>
            <% end %>
            <a href="#"
               aria-disabled="true"
               title="<%= t('opensop.common.coming_soon') %>"
               class="inline-flex justify-center items-center rounded-md border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-400 cursor-not-allowed">
              <%= t('opensop.processes.show.view_metrics') %>
            </a>
          </div>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(
        title: t('opensop.processes.title'),
        description: t('opensop.processes.empty')
      ) %>
<% end %>
