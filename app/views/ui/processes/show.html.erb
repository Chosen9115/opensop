<% defn = @definition; pblock = @process_block %>
<% inputs = pblock["inputs"] || []; outputs = pblock["outputs"] || []; steps_list = pblock["steps"] || [] %>
<% trigger = pblock.dig("trigger", "type"); sla = pblock.dig("sla", "target"); description = pblock["description"] %>

<!-- Breadcrumb -->
<nav class="mb-3 flex items-center gap-1.5 text-[11px] font-mono text-fg-muted" aria-label="Breadcrumb">
  <%= link_to t('opensop.nav.processes'), ui_processes_path, class: "hover:text-fg" %>
  <span class="text-fg-faint">/</span>
  <span class="text-fg"><%= @process.name %></span>
</nav>

<!-- Header -->
<header class="mb-6 flex items-start justify-between gap-4 flex-wrap">
  <div class="min-w-0">
    <div class="flex items-baseline gap-2 flex-wrap">
      <h1 class="text-[20px] font-mono font-semibold text-fg"><%= @process.name %></h1>
      <span class="font-mono text-[11px] text-fg-faint">v<%= @process.version %></span>
      <%= render PillComponent.new(state: @process.status.to_s) %>
    </div>
    <% if description.present? %>
      <p class="mt-1 text-[12px] text-fg-muted max-w-3xl"><%= description %></p>
    <% end %>
    <% older_versions = @versions.reject { |v| v == @process.version } %>
    <% if older_versions.any? %>
      <div class="mt-1 flex items-center gap-1.5 text-[11px] font-mono text-fg-faint">
        <span><%= t('opensop.processes.show.other_versions') %>:</span>
        <% older_versions.sort_by { |v| Gem::Version.new(v.to_s) rescue Gem::Version.new("0") }.reverse.each do |v| %>
          <%= link_to "v#{v}", ui_process_path(name: @process.name, version: v), class: "hover:text-fg underline" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to t('opensop.processes.show.view_instances'), ui_instances_path(process: @process.name), class: "btn-pp btn-pp-sm" %>
    <button type="button"
            class="btn-pp btn-pp-primary btn-pp-sm"
            onclick="document.getElementById('trigger-run-panel').classList.toggle('hidden')">
      <%= t('opensop.processes.show.trigger_run') %>
    </button>
  </div>
</header>

<!-- Trigger run panel -->
<div id="trigger-run-panel" class="<%= inputs.empty? ? 'hidden' : 'hidden' %> mb-6 rounded-[3px] border border-border bg-bg p-4">
  <h2 class="pp-section-title mb-3"><%= t('opensop.processes.show.trigger_run_heading') %></h2>
  <%= form_with url: runs_ui_process_path(name: @process.name), method: :post, local: true do |f| %>
    <% if inputs.any? %>
      <div class="space-y-3 mb-4">
        <% inputs.each do |input| %>
          <div>
            <label class="block text-[11px] font-mono text-fg-muted mb-0.5">
              <%= input["name"] %>
              <% if input["required"] %>
                <span class="text-warn">*</span>
              <% end %>
              <% if input["description"].present? %>
                <span class="text-fg-faint ml-1">— <%= input["description"] %></span>
              <% end %>
            </label>
            <% field_type = case input["type"] when "integer", "number" then "number" else "text" end %>
            <%= f.text_field "inputs[#{input["name"]}]",
                type: field_type,
                required: input["required"],
                placeholder: input["example"]&.to_s,
                class: "w-full rounded-[3px] border border-border bg-bg px-2 py-1 text-[12px] font-mono focus:border-border-focus focus:outline-none" %>
          </div>
        <% end %>
      </div>
    <% end %>
    <div class="flex items-center gap-2">
      <%= f.submit t('opensop.processes.show.start_run_button'), class: "btn-pp btn-pp-primary btn-pp-sm" %>
      <button type="button"
              class="btn-pp btn-pp-sm"
              onclick="document.getElementById('trigger-run-panel').classList.add('hidden')">
        <%= t('opensop.common.cancel') %>
      </button>
    </div>
  <% end %>
</div>

<!-- Meta grid -->
<div class="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-8">
  <div class="rounded-[3px] border border-border bg-bg p-3">
    <div class="pp-section-title"><%= t('opensop.processes.show.owner') %></div>
    <div class="mt-1 text-[13px] text-fg"><%= (pblock['owner'] || @process.owner).presence || t('opensop.common.none') %></div>
  </div>
  <div class="rounded-[3px] border border-border bg-bg p-3">
    <div class="pp-section-title"><%= t('opensop.processes.show.sla') %></div>
    <div class="mt-1 text-[13px] text-fg tabular-nums"><%= sla.presence || "—" %></div>
  </div>
  <div class="rounded-[3px] border border-border bg-bg p-3">
    <div class="pp-section-title"><%= t('opensop.processes.show.trigger') %></div>
    <div class="mt-1 text-[13px] font-mono text-fg"><%= trigger.presence || t('opensop.common.none') %></div>
  </div>
  <div class="rounded-[3px] border border-border bg-bg p-3">
    <div class="pp-section-title"><%= t('opensop.processes.show.tags') %></div>
    <div class="mt-1 flex flex-wrap gap-1">
      <% tags = pblock["tags"] || @process.tags || [] %>
      <% if tags.any? %>
        <% tags.each do |tag| %><span class="pp-tag"><%= tag %></span><% end %>
      <% else %>
        <span class="text-[12px] text-fg-faint"><%= t('opensop.common.none') %></span>
      <% end %>
    </div>
  </div>
</div>

<!-- Inputs -->
<section class="mb-8">
  <h2 class="pp-section-title mb-3"><%= t('opensop.processes.show.inputs') %></h2>
  <%= render FieldListComponent.new(fields: inputs) %>
</section>

<!-- Outputs -->
<section class="mb-8">
  <h2 class="pp-section-title mb-3"><%= t('opensop.processes.show.outputs') %></h2>
  <%= render FieldListComponent.new(fields: outputs) %>
</section>

<!-- Steps -->
<section class="mb-8">
  <h2 class="pp-section-title mb-3"><%= t('opensop.processes.show.steps') %></h2>
  <% if steps_list.any? %>
    <ol class="space-y-2">
      <% steps_list.each_with_index do |step, idx| %>
        <li class="rounded-[3px] border border-border bg-bg p-4">
          <div class="flex items-start gap-3">
            <div class="flex h-6 w-6 items-center justify-center rounded-full border border-border bg-bg-sunken font-mono text-[11px] tabular-nums text-fg-muted shrink-0"><%= idx + 1 %></div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-[13px] font-semibold text-fg"><%= step["name"] || step["id"] %></h3>
                <code class="font-mono text-[10px] text-fg-faint"><%= step["id"] %></code>
                <span class="pp-tag"><%= step["type"] %></span>
                <% if step["condition"].present? %>
                  <span class="pp-pill bg-warn-bg text-warn"><span class="pp-pill-dot bg-warn"></span>if <%= step["condition"] %></span>
                <% end %>
              </div>
              <% if step["description"].present? %>
                <p class="mt-1 text-[12px] text-fg-muted"><%= step["description"] %></p>
              <% end %>

              <!-- inputs -->
              <% if (step["inputs"] || []).any? %>
                <div class="mt-2">
                  <div class="pp-section-title mb-1"><%= t('opensop.processes.show.inputs') %></div>
                  <div class="flex flex-wrap gap-1.5">
                    <% step["inputs"].each do |input| %>
                      <span class="inline-flex items-center gap-1 rounded-[3px] bg-bg-sunken border border-border px-1.5 py-0.5 font-mono text-[10px] text-fg">
                        <span class="font-semibold"><%= input["name"] %></span>
                        <% if input["from"].present? %><span class="text-fg-faint">←</span><span class="text-fg-muted"><%= input["from"] %></span><% end %>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <!-- outputs -->
              <% if (step["outputs"] || []).any? %>
                <div class="mt-2">
                  <div class="pp-section-title mb-1"><%= t('opensop.processes.show.outputs') %></div>
                  <div class="flex flex-wrap gap-1.5">
                    <% step["outputs"].each do |out| %>
                      <span class="inline-flex items-center rounded-[3px] bg-bg-sunken border border-border px-1.5 py-0.5 font-mono text-[10px] text-fg">
                        <%= out["name"] %> (<%= out["type"] || "string" %>)
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <!-- type-specific -->
              <% case step["type"] %>
              <% when "judgment" %>
                <% if step["judgment"].present? %>
                  <div class="mt-2 text-[11px] text-fg-muted font-mono">
                    threshold: <span class="text-fg tabular-nums"><%= step["judgment"]["confidence_threshold"] || "—" %></span>
                    <span class="ml-3">escalation:</span> <span class="text-fg"><%= step["judgment"]["escalation"] || "—" %></span>
                  </div>
                <% end %>
              <% when "webhook" %>
                <% if step["webhook"].present? %>
                  <div class="mt-2 text-[11px] text-fg-muted font-mono space-y-0.5">
                    <div>url: <code class="text-fg"><%= step["webhook"]["url"] %></code></div>
                    <div>method: <code class="text-fg"><%= step["webhook"]["method"] || "POST" %></code> <span class="ml-3">mode:</span> <code class="text-fg"><%= step["webhook"]["response_mode"] || "sync" %></code></div>
                  </div>
                <% end %>
              <% when "automated" %>
                <% if step["run"].present? %>
                  <div class="mt-2 text-[11px] text-fg-muted font-mono">script: <code class="text-fg"><%= step["run"] %></code></div>
                <% end %>
              <% when "subprocess" %>
                <% if step["subprocess"].present? %>
                  <div class="mt-2 text-[11px] text-fg-muted font-mono">process: <code class="text-fg"><%= step["subprocess"]["name"] || step["subprocess"] %></code></div>
                <% end %>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <div class="rounded-[3px] border border-border bg-bg-sunken p-6 text-center text-[12px] text-fg-muted"><%= t('opensop.common.empty_state') %></div>
  <% end %>
</section>

<!-- Raw definition -->
<section>
  <details class="rounded-[3px] border border-border bg-bg">
    <summary class="cursor-pointer select-none px-4 py-3 text-[12px] font-medium text-fg hover:bg-bg-hover">
      <%= t('opensop.processes.show.raw_definition') %>
    </summary>
    <pre class="px-4 py-3 bg-bg-sunken border-t border-border overflow-x-auto text-[11px] font-mono text-fg leading-relaxed"><code><%= YAML.dump(defn) %></code></pre>
  </details>
</section>
