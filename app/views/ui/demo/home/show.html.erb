<%# Demo homepage — shown only when DEMO_MODE=true. %>

<%# ── Hero ────────────────────────────────────────────────────────────────── %>
<div class="mb-12 pt-4">
  <h1 class="text-[32px] font-semibold text-fg leading-tight tracking-tight">
    <%= t('opensop.app.name') %>
  </h1>
  <p class="mt-2 text-[15px] text-fg-muted max-w-xl">
    <%= t('opensop.app.tagline') %>
  </p>
  <p class="mt-3 text-[13px] text-fg-faint">
    <%= t('opensop.demo.home.hero.reset_note', schedule: @reset_schedule) %>
  </p>
</div>

<%# ── Try the API ─────────────────────────────────────────────────────────── %>
<section class="mb-12" aria-label="<%= t('opensop.demo.home.api.section_label') %>">
  <h2 class="pp-section-title mb-3"><%= t('opensop.demo.home.api.heading') %></h2>

  <div class="rounded-[4px] border border-border bg-bg-code p-5 space-y-4">
    <%# Token row %>
    <div class="flex items-center gap-3">
      <span class="pp-section-title"><%= t('opensop.demo.home.api.token_label') %></span>
      <div class="flex items-center gap-2"
           data-controller="demo-clipboard"
           data-demo-clipboard-text-value="<%= @api_token %>">
        <code class="font-mono text-[12px] bg-bg-pill px-2 py-1 rounded-[3px] text-fg select-all"
              data-demo-clipboard-target="source">
          <%= @api_token %>
        </code>
        <button class="btn-pp btn-pp-sm flex items-center gap-1"
                data-action="click->demo-clipboard#copy"
                aria-label="<%= t('opensop.demo.home.api.copy_token_aria') %>">
          <%# Heroicons clipboard-document mini — inline SVG from heroicons.com %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
          <path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0118 5.25v6.5A2.25 2.25 0 0115.75 14H13.5v-3.379a3 3 0 00-.879-2.121l-3.12-3.121a3 3 0 00-1.402-.791A2.252 2.252 0 0110.25 3h5.738zM10.5 4.496v1.254a3 3 0 003 3h1.254a4.5 4.5 0 00-.508-.882L10.882 5.004a4.5 4.5 0 00-.882-.508z" clip-rule="evenodd" />
          <path d="M8.878 5.56A1.5 1.5 0 007.5 6.75v7.5a1.5 1.5 0 001.5 1.5h5.25a1.5 1.5 0 001.5-1.5V14H10.75A2.25 2.25 0 018.5 11.75V7.5c0-.617.249-1.175.652-1.582L8.878 5.56z" />
          <path fill-rule="evenodd" d="M2 6.75A2.25 2.25 0 014.25 4.5h5.25a2.25 2.25 0 012.25 2.25v7.5A2.25 2.25 0 019.5 16.5h-5.25A2.25 2.25 0 012 14.25v-7.5zm6 4.5a.75.75 0 00-.75-.75H4.5a.75.75 0 000 1.5h2.75a.75.75 0 00.75-.75zm0-3a.75.75 0 00-.75-.75H4.5a.75.75 0 000 1.5h2.75a.75.75 0 00.75-.75z" clip-rule="evenodd" />
        </svg>
          <span data-demo-clipboard-target="label"><%= t('opensop.demo.home.api.copy_button') %></span>
        </button>
      </div>
    </div>

    <%# Example curl %>
    <div>
      <p class="pp-section-title mb-2"><%= t('opensop.demo.home.api.example_label') %></p>
      <pre class="font-mono text-[12px] text-fg-muted overflow-x-auto whitespace-pre-wrap break-all leading-relaxed"><span class="text-fg-faint"># List all processes</span>
curl <%= request.base_url %>/sop/ \
  -H "X-SOP-Token: <strong><%= @api_token %></strong>"

<span class="text-fg-faint"># Start an instance</span>
curl -X POST <%= request.base_url %>/sop/&lt;process-name&gt;/start \
  -H "X-SOP-Token: <strong><%= @api_token %></strong>" \
  -H "Content-Type: application/json" \
  -d '{"inputs": {}}'</pre>
    </div>
  </div>
</section>

<%# ── Sample processes ───────────────────────────────────────────────────── %>
<section class="mb-12" aria-label="<%= t('opensop.demo.home.processes.section_label') %>">
  <h2 class="pp-section-title mb-3"><%= t('opensop.demo.home.processes.heading') %></h2>

  <% if @example_processes.any? %>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% @example_processes.each do |process| %>
        <div class="rounded-[4px] border border-border bg-bg p-4 flex flex-col gap-2 hover:bg-bg-hover transition-colors">
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-medium text-fg text-[13px] leading-tight">
              <%= link_to process.name,
                    ui_process_path(name: process.name),
                    class: "hover:underline" %>
            </h3>
            <span class="pp-tag shrink-0">v<%= process.version %></span>
          </div>

          <% if process.description.present? %>
            <p class="text-[12px] text-fg-muted line-clamp-2"><%= process.description %></p>
          <% end %>

          <% if process.tags.any? %>
            <div class="flex flex-wrap gap-1 mt-auto pt-1">
              <% process.tags.first(4).each do |tag| %>
                <span class="pp-tag"><%= tag %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-[13px] text-fg-faint"><%= t('opensop.demo.home.processes.empty') %></p>
  <% end %>
</section>

<%# ── Docs CTA ────────────────────────────────────────────────────────────── %>
<section class="mb-12" aria-label="<%= t('opensop.demo.home.docs.section_label') %>">
  <h2 class="pp-section-title mb-3"><%= t('opensop.demo.home.docs.heading') %></h2>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <a href="<%= ui_docs_path %>"
       class="group rounded-[4px] border border-border bg-bg p-5 hover:bg-bg-hover transition-colors flex items-start gap-3">
      <%# Heroicons book-open outline — inline SVG from heroicons.com %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-fg-muted mt-0.5 shrink-0" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
      </svg>
      <div>
        <p class="font-medium text-fg text-[13px]"><%= t('opensop.demo.home.docs.guides_title') %></p>
        <p class="mt-1 text-[12px] text-fg-muted"><%= t('opensop.demo.home.docs.guides_body') %></p>
      </div>
    </a>

    <a href="<%= ui_api_docs_path %>"
       class="group rounded-[4px] border border-border bg-bg p-5 hover:bg-bg-hover transition-colors flex items-start gap-3">
      <%# Heroicons code-bracket outline — inline SVG from heroicons.com %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-fg-muted mt-0.5 shrink-0" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
      </svg>
      <div>
        <p class="font-medium text-fg text-[13px]"><%= t('opensop.demo.home.docs.api_title') %></p>
        <p class="mt-1 text-[12px] text-fg-muted"><%= t('opensop.demo.home.docs.api_body') %></p>
      </div>
    </a>
  </div>
</section>

<%# ── Footer ──────────────────────────────────────────────────────────────── %>
<footer class="border-t border-border pt-6 pb-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-[11px] text-fg-faint">
  <a href="https://github.com/Chosen9115/opensop"
     class="hover:text-fg-muted transition-colors"
     target="_blank"
     rel="noopener noreferrer">
    <%= t('opensop.demo.home.footer.github') %>
  </a>
  <span><%= t('opensop.demo.home.footer.license') %></span>
  <span><%= t('opensop.demo.home.footer.built_on') %></span>
</footer>
