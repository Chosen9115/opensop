<header class="mb-6 flex items-start justify-between gap-4">
  <div>
    <h1 class="text-[20px] font-semibold tracking-tight"><%= t('opensop.auth.account.sessions.title') %></h1>
    <p class="mt-1 text-[12px] text-fg-muted"><%= t('opensop.auth.account.sessions.subtitle') %></p>
  </div>

  <% if @sessions.any?(&->(s) { s.id != current_session_id }) %>
    <%= button_to destroy_others_ui_account_sessions_path,
          method: :delete,
          class: "rounded-[3px] border border-border bg-bg px-3 py-2 text-[12px] font-medium hover:bg-bg-hover" do %>
      <%= t('opensop.auth.account.sessions.revoke_others') %>
    <% end %>
  <% end %>
</header>

<section>
  <div class="border border-border rounded-[3px] divide-y divide-border bg-bg overflow-hidden">
    <div class="grid grid-cols-[1fr_140px_180px_180px_140px] gap-4 px-4 py-2 text-[10px] font-mono uppercase tracking-[0.08em] text-fg-muted bg-bg-sunken">
      <span><%= t('opensop.auth.account.sessions.user_agent') %></span>
      <span><%= t('opensop.auth.account.sessions.ip') %></span>
      <span><%= t('opensop.auth.account.sessions.last_used') %></span>
      <span><%= t('opensop.auth.account.passkeys.registered') %></span>
      <span class="text-right"></span>
    </div>

    <% @sessions.each do |session| %>
      <% is_current = session.id == current_session_id %>
      <div id="<%= dom_id(session) %>"
           class="grid grid-cols-[1fr_140px_180px_180px_140px] items-center gap-4 px-4 py-3 <%= 'bg-bg-pill' if is_current %>">
        <div class="min-w-0">
          <div class="font-mono text-[12px] text-fg truncate" title="<%= session.user_agent %>">
            <%= session.user_agent.presence || "—" %>
          </div>
          <% if is_current %>
            <div class="mt-1">
              <%= render PillComponent.new(state: :active,
                    label: t('opensop.auth.account.sessions.this_session')) %>
            </div>
          <% end %>
        </div>
        <div class="font-mono text-[11px] text-fg-muted">
          <%= session.ip_address || "—" %>
        </div>
        <div class="text-[11px] text-fg-muted font-mono">
          <% if session.last_used_at.present? %>
            <%= render TimestampComponent.new(time: session.last_used_at) %>
          <% else %>
            <span class="text-fg-faint"><%= t('opensop.auth.account.passkeys.last_used_never') %></span>
          <% end %>
        </div>
        <div class="text-[11px] text-fg-muted font-mono">
          <%= render TimestampComponent.new(time: session.created_at) %>
        </div>
        <div class="text-right">
          <% if is_current %>
            <span class="text-[11px] text-fg-faint font-mono">—</span>
          <% else %>
            <%= button_to ui_account_session_path(session),
                  method: :delete,
                  class: "inline-flex items-center gap-1.5 rounded-[3px] border border-border bg-bg px-2 py-1 text-[11px] font-medium text-err hover:bg-err-bg" do %>
              <%= t('opensop.auth.account.sessions.revoke') %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
