<header class="mb-6">
  <h1 class="text-[20px] font-semibold tracking-tight"><%= t('opensop.auth.account.users.title') %></h1>
  <p class="mt-1 text-[12px] text-fg-muted"><%= t('opensop.auth.account.users.subtitle') %></p>
</header>

<%# Invite an admin. Always-visible card; submitting issues a 7-day %>
<%# invitation token and sends an email. %>
<section class="mb-8 rounded-[3px] border border-border bg-bg-sunken p-4">
  <h2 class="pp-section-title mb-3"><%= t('opensop.auth.account.users.invite_heading') %></h2>

  <%= form_with model: @new_user,
        url: ui_account_users_path,
        scope: :user,
        local: true,
        class: "grid grid-cols-[1fr_1fr_auto] gap-3 items-end" do |f| %>
    <div>
      <%= f.label :email, t('opensop.auth.account.users.email_label'),
            class: "block text-[11px] font-medium text-fg-muted mb-1" %>
      <%= f.email_field :email,
            required: true,
            placeholder: "you@example.com",
            class: "w-full rounded-[3px] border border-border bg-bg px-2 py-1.5 text-[12px] focus:border-border-focus focus:outline-none" %>
    </div>
    <div>
      <%= f.label :display_name, t('opensop.auth.account.users.display_name_label'),
            class: "block text-[11px] font-medium text-fg-muted mb-1" %>
      <%= f.text_field :display_name,
            maxlength: 100,
            class: "w-full rounded-[3px] border border-border bg-bg px-2 py-1.5 text-[12px] focus:border-border-focus focus:outline-none" %>
    </div>
    <div>
      <%= f.submit t('opensop.auth.account.users.invite_cta'),
            class: "rounded-[3px] border border-border bg-fg px-4 py-2 text-[12px] font-medium text-bg hover:opacity-90 cursor-pointer" %>
    </div>
  <% end %>
</section>

<section>
  <div class="border border-border rounded-[3px] divide-y divide-border bg-bg overflow-hidden">
    <div class="grid grid-cols-[1fr_180px_120px_140px_180px_120px] gap-4 px-4 py-2 text-[10px] font-mono uppercase tracking-[0.08em] text-fg-muted bg-bg-sunken">
      <span><%= t('opensop.auth.account.users.email_label') %></span>
      <span><%= t('opensop.auth.account.users.display_name_label') %></span>
      <span></span>
      <span></span>
      <span></span>
      <span class="text-right"></span>
    </div>

    <% @users.each do |user| %>
      <% pk_count = user.respond_to?(:passkey_count) ? user.passkey_count.to_i : user.passkey_credentials.count %>
      <% active = pk_count.positive? %>
      <div id="<%= dom_id(user) %>"
           class="grid grid-cols-[1fr_180px_120px_140px_180px_120px] items-center gap-4 px-4 py-3 hover:bg-bg-hover">
        <div class="min-w-0">
          <div class="font-mono text-[12px] text-fg truncate"><%= user.email %></div>
        </div>
        <div class="text-[12px] text-fg-muted truncate">
          <% if user.display_name.present? %>
            <%= user.display_name %>
          <% else %>
            <span class="text-fg-faint">—</span>
          <% end %>
        </div>
        <div>
          <% if active %>
            <%= render PillComponent.new(state: :active,
                  label: t('opensop.auth.account.users.status_active')) %>
          <% else %>
            <%= render PillComponent.new(state: :pending,
                  label: t('opensop.auth.account.users.status_pending')) %>
          <% end %>
        </div>
        <div class="text-[11px] text-fg-muted font-mono">
          <%= t('opensop.auth.account.users.passkey_count', count: pk_count) %>
        </div>
        <div class="text-[11px] text-fg-muted font-mono">
          <% if user.last_signed_in_at.present? %>
            <%= render TimestampComponent.new(time: user.last_signed_in_at) %>
          <% else %>
            <span class="text-fg-faint"><%= t('opensop.auth.account.passkeys.last_used_never') %></span>
          <% end %>
        </div>
        <div class="text-right">
          <% if user == current_user %>
            <span class="text-[11px] text-fg-faint font-mono">—</span>
          <% else %>
            <%= button_to ui_account_user_path(user),
                  method: :delete,
                  form: { data: { turbo_confirm: t('opensop.auth.account.users.remove_confirm', email: user.email) } },
                  class: "inline-flex items-center gap-1.5 rounded-[3px] border border-border bg-bg px-2 py-1 text-[11px] font-medium text-err hover:bg-err-bg" do %>
              <%= t('opensop.auth.account.users.remove') %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
