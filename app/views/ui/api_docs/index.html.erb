<section class="mb-8">
  <h1 class="text-2xl font-semibold tracking-tight text-fg">
    <%= t('opensop.api_docs.title', default: 'API & SDK') %>
  </h1>
  <p class="mt-2 text-sm text-fg-muted max-w-3xl">
    <%= t('opensop.api_docs.subtitle', default: 'Define a process, get an API. Agents and humans interact through the same /sop/* endpoints.') %>
  </p>
</section>

<section class="mb-10">
  <h2 class="pp-section-title">
    <%= t('opensop.api_docs.auth.heading', default: 'Authentication') %>
  </h2>
  <div class="mt-3 rounded-[3px] border border-border bg-bg p-4 text-sm text-fg space-y-3">
    <p>
      <%= t('opensop.api_docs.auth.header_intro_html',
            default: 'Every request to <code class="font-mono text-[12px] bg-bg-pill px-1 py-0.5 rounded-[3px]">/sop/*</code> must include the <code class="font-mono text-[12px] bg-bg-pill px-1 py-0.5 rounded-[3px]">X-SOP-Token</code> header.').html_safe %>
    </p>
    <p>
      <%= t('opensop.api_docs.auth.env_intro_html',
            default: 'The expected token is read from the <code class="font-mono text-[12px] bg-bg-pill px-1 py-0.5 rounded-[3px]">OPENSOP_API_TOKEN</code> environment variable.').html_safe %>
    </p>
    <p class="text-fg-muted">
      <%= t('opensop.api_docs.auth.fallback',
            default: 'If OPENSOP_API_TOKEN is unset, the engine falls back to no-auth (intended for local development and tests). Set the variable in any deployment that should be locked down.') %>
    </p>
<pre class="bg-bg-sunken border border-border rounded-[3px] p-4 font-mono text-[12px] overflow-x-auto"><code>curl -H "X-SOP-Token: $OPENSOP_API_TOKEN" http://your-host/sop/</code></pre>
  </div>
</section>

<section class="mb-10">
  <h2 class="pp-section-title">
    <%= t('opensop.api_docs.endpoints.heading', default: 'Endpoints') %>
  </h2>
  <p class="mt-2 text-sm text-fg-muted">
    <%= t('opensop.api_docs.endpoints.intro', default: 'All public endpoints exposed by the engine. JSON request/response bodies.') %>
  </p>

  <div class="mt-4 rounded-[3px] border border-border bg-bg overflow-hidden">
    <div class="grid grid-cols-[80px_1fr_1fr] gap-x-4 px-4 py-2 border-b border-border bg-bg-sunken text-[11px] uppercase tracking-wide text-fg-muted font-medium">
      <span><%= t('opensop.api_docs.endpoints.col_method', default: 'Method') %></span>
      <span><%= t('opensop.api_docs.endpoints.col_path', default: 'Path') %></span>
      <span><%= t('opensop.api_docs.endpoints.col_description', default: 'Description') %></span>
    </div>

    <% @endpoints.each_with_index do |ep, idx| %>
      <div class="grid grid-cols-[80px_1fr_1fr] gap-x-4 px-4 py-3 items-center text-sm <%= 'border-t border-border' if idx > 0 %>">
        <span>
          <span class="pp-tag <%= ep[:method] == 'GET' ? 'text-info' : 'text-warn' %>">
            <%= ep[:method] %>
          </span>
        </span>
        <code class="font-mono text-[12px] text-fg break-all"><%= ep[:path] %></code>
        <span class="text-fg-muted">
          <%= t("opensop.api_docs.endpoints.descriptions.#{ep[:desc_key]}",
                default: @endpoint_descriptions[ep[:desc_key]]) %>
        </span>
      </div>
    <% end %>
  </div>
</section>

<section class="mb-10">
  <h2 class="pp-section-title">
    <%= t('opensop.api_docs.snippets.heading', default: 'Snippet library') %>
  </h2>
  <p class="mt-2 text-sm text-fg-muted">
    <%= t('opensop.api_docs.snippets.intro', default: 'Copy-paste examples for the two most common flows.') %>
  </p>

  <div class="mt-6 space-y-8">
    <div>
      <h3 class="text-sm font-semibold text-fg mb-3">
        <%= t('opensop.api_docs.snippets.start.heading', default: 'Start an instance') %>
      </h3>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wide text-fg-muted mb-2">curl</p>
<pre class="bg-bg-sunken border border-border rounded-[3px] p-4 font-mono text-[12px] overflow-x-auto"><code>curl -X POST http://your-host/sop/customer-onboarding/start \
  -H "X-SOP-Token: $OPENSOP_API_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"inputs": {"company_name": "Acme Inc"}}'</code></pre>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wide text-fg-muted mb-2">ruby</p>
<pre class="bg-bg-sunken border border-border rounded-[3px] p-4 font-mono text-[12px] overflow-x-auto"><code>require "net/http"; require "json"
uri = URI("http://your-host/sop/customer-onboarding/start")
req = Net::HTTP::Post.new(uri, "X-SOP-Token" => ENV["OPENSOP_API_TOKEN"], "Content-Type" => "application/json")
req.body = { inputs: { company_name: "Acme Inc" } }.to_json
res = Net::HTTP.start(uri.host, uri.port) { |h| h.request(req) }
puts JSON.parse(res.body)</code></pre>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wide text-fg-muted mb-2">python</p>
<pre class="bg-bg-sunken border border-border rounded-[3px] p-4 font-mono text-[12px] overflow-x-auto"><code>import os, requests
r = requests.post(
    "http://your-host/sop/customer-onboarding/start",
    headers={"X-SOP-Token": os.environ["OPENSOP_API_TOKEN"]},
    json={"inputs": {"company_name": "Acme Inc"}},
)
print(r.json())</code></pre>
        </div>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-fg mb-3">
        <%= t('opensop.api_docs.snippets.submit.heading', default: 'Submit a step') %>
      </h3>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wide text-fg-muted mb-2">curl</p>
<pre class="bg-bg-sunken border border-border rounded-[3px] p-4 font-mono text-[12px] overflow-x-auto"><code>curl -X POST http://your-host/sop/customer-onboarding/&lt;id&gt;/steps/&lt;step_id&gt;/submit \
  -H "X-SOP-Token: $OPENSOP_API_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"outputs": {"approved": true}}'</code></pre>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wide text-fg-muted mb-2">ruby</p>
<pre class="bg-bg-sunken border border-border rounded-[3px] p-4 font-mono text-[12px] overflow-x-auto"><code>require "net/http"; require "json"
uri = URI("http://your-host/sop/customer-onboarding/&lt;id&gt;/steps/&lt;step_id&gt;/submit")
req = Net::HTTP::Post.new(uri, "X-SOP-Token" => ENV["OPENSOP_API_TOKEN"], "Content-Type" => "application/json")
req.body = { outputs: { approved: true } }.to_json
res = Net::HTTP.start(uri.host, uri.port) { |h| h.request(req) }
puts JSON.parse(res.body)</code></pre>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wide text-fg-muted mb-2">python</p>
<pre class="bg-bg-sunken border border-border rounded-[3px] p-4 font-mono text-[12px] overflow-x-auto"><code>import os, requests
r = requests.post(
    "http://your-host/sop/customer-onboarding/&lt;id&gt;/steps/&lt;step_id&gt;/submit",
    headers={"X-SOP-Token": os.environ["OPENSOP_API_TOKEN"]},
    json={"outputs": {"approved": True}},
)
print(r.json())</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
