<%# Markdown guide dispatcher — renders the per-slug partial. Returns a %>
<%# friendly fallback if Phase 2 hasn't shipped the partial for this slug yet. %>
<% partial_name = "ui/api_docs/guides/#{@guide[:slug].underscore}" %>
<% if lookup_context.exists?(partial_name, [], true, [], formats: [ :md ]) -%>
<%= render partial: partial_name, formats: [ :md ] %>
<% else -%>
# <%= @guide[:label] %>

> Markdown content for guide `<%= @guide[:slug] %>` is pending — see the HTML
> version at /api-docs/guides/<%= @guide[:slug] %> for now.
<% end -%>
