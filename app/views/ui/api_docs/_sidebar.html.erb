<%# Sidebar for the API Reference site — 240px, bg-sunken, border-r %>
<%# Active state is determined server-side by comparing request.path to route helpers. %>
<nav class="w-[240px] shrink-0 bg-bg-sunken border-r border-border h-full overflow-y-auto py-4">

  <%# ===== GETTING STARTED section ===== %>
  <div class="mb-4">
    <div class="flex items-center justify-between px-4 mb-1">
      <span class="font-mono text-[9px] uppercase tracking-[0.06em] text-[#9aa0a8] font-medium">
        <%= t('opensop.api_docs.sidebar.sections.getting_started') %>
      </span>
      <span class="font-mono text-[10px] text-[#9aa0a8] bg-[#eef0f3] px-1 py-px rounded-[2px]">
        <%= Ui::ApiDocs::Catalog::GUIDES.size %>
      </span>
    </div>

    <% Ui::ApiDocs::Catalog::GUIDES.each do |guide| %>
      <%
        if guide[:slug] == "quickstart"
          href = ui_api_docs_path
          is_active = (request.path == ui_api_docs_path || request.path == ui_api_docs_guide_path("quickstart"))
        else
          href = ui_api_docs_guide_path(guide[:slug])
          is_active = (request.path == href)
        end
      %>
      <%= link_to href,
                  class: [
                    "flex items-center justify-between px-3.5 py-0 h-7 text-[12px] transition-colors",
                    is_active ? "bg-bg text-[#0f1115] font-medium shadow-[inset_2px_0_0_#0f1115] shadow-[0_1px_2px_rgba(0,0,0,0.04)]" : "text-[#5d6470] hover:bg-[#f0f2f5]"
                  ].join(" ") do %>
        <span><%= t("opensop.api_docs.guides.#{guide[:slug].underscore}.label") %></span>
        <span class="text-[#9aa0a8] text-[11px]">→</span>
      <% end %>
    <% end %>
  </div>

  <%# ===== ENDPOINT SECTIONS ===== %>
  <% Ui::ApiDocs::Catalog::ENDPOINT_SECTIONS.each do |section| %>
    <div class="mb-4">
      <div class="flex items-center justify-between px-4 mb-1">
        <span class="font-mono text-[9px] uppercase tracking-[0.06em] text-[#9aa0a8] font-medium">
          <%= t("opensop.api_docs.sidebar.sections.#{section[:key]}") %>
        </span>
        <span class="font-mono text-[10px] text-[#9aa0a8] bg-[#eef0f3] px-1 py-px rounded-[2px]">
          <%= section[:endpoints].size %>
        </span>
      </div>

      <% section[:endpoints].each do |ep| %>
        <%
          href = ui_api_docs_endpoint_path(ep[:slug])
          is_active = (request.path == href)
          method_class = case ep[:method]
                         when "GET"    then "text-[#1f4ed8]"
                         when "POST"   then "text-[#0f7a3d]"
                         when "DELETE" then "text-[#b03333]"
                         else               "text-[#5d6470]"
                         end
        %>
        <%= link_to href,
                    class: [
                      "flex items-center gap-2 px-3.5 py-0 h-7 text-[12px] transition-colors overflow-hidden",
                      is_active ? "bg-bg text-[#0f1115] font-medium shadow-[inset_2px_0_0_#0f1115] shadow-[0_1px_2px_rgba(0,0,0,0.04)]" : "text-[#5d6470] hover:bg-[#f0f2f5]"
                    ].join(" ") do %>
          <span class="font-mono text-[9px] font-semibold shrink-0 <%= method_class %>"><%= ep[:method] %></span>
          <span class="font-mono text-[11px] text-[#0f1115] truncate min-w-0"><%= ep[:path] %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</nav>
