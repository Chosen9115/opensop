<%
  endpoint = Ui::ApiDocs::Catalog.endpoint("deliver-callback")
  section  = Ui::ApiDocs::Catalog.section_for_endpoint("deliver-callback")
%>
<%= render "ui/api_docs/page_header",
      crumbs: [["api", nil], [section[:label], nil], [t('opensop.api_docs.endpoints.deliver_callback.title'), nil]],
      title: t('opensop.api_docs.endpoints.deliver_callback.title'),
      method: endpoint[:method],
      path: endpoint[:path] %>

<div class="px-10 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] gap-12">

    <div class="space-y-6">
      <p class="text-[14px] text-[#5d6470] leading-relaxed"><%= t('opensop.api_docs.endpoints.deliver_callback.description') %></p>

      <%= render Ui::ApiDocs::CalloutComponent.new(variant: :info, label: "AUTH") do |c| %>
        <% c.with_body do %>No bearer token required. The ULID in the path <em>is</em> the credential — it is single-use and time-limited.<% end %>
      <% end %>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.path_params') %></h2>
        <dl class="space-y-4">
          <div>
            <dt class="flex items-center gap-2 mb-1">
              <span class="font-mono text-[13px] text-[#0f1115]">callback_id</span>
              <span class="font-mono text-[11px] text-[#5d6470]">string (ULID)</span>
              <span class="font-mono text-[9px] font-bold uppercase bg-[#fbe9e9] text-[#b03333] rounded-[3px] px-1.5 py-px">REQUIRED</span>
            </dt>
            <dd class="text-[13px] text-[#5d6470]">One-shot ULID generated by the engine when a webhook step starts. Obtain from the step's <code class="font-mono text-[11px] bg-[#eef0f3] px-1 rounded-[3px]">callback_url</code> field.</dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.response') %></h2>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#e7f6ec] text-[#0f7a3d]">200</span>
          <span class="text-[13px] text-[#5d6470]">application/json — Step advanced; instance continues execution.</span>
        </div>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.errors_heading') %></h2>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">404</span>
          <code class="font-mono text-[12px] text-[#0f1115]">not_found</code>
          <span class="text-[13px] text-[#5d6470]">Callback ID does not exist or has expired.</span>
        </div>
        <div class="flex items-center gap-3 py-3">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">409</span>
          <code class="font-mono text-[12px] text-[#0f1115]">callback_already_resolved</code>
          <span class="text-[13px] text-[#5d6470]">This URL was already consumed.</span>
        </div>
      </div>
    </div>

    <%
      curl_req  = "curl https://api.opensop.dev/sop/webhooks/01HXYZ_CB_TOKEN \\\n  -X POST \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"status\":\"success\",\"document_id\":\"DOC-1234\"}'"
      node_req  = "await fetch(\n  `https://api.opensop.dev/sop/webhooks/${callbackId}`,\n  {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ status: \"success\" })\n  }\n);"
      py_req    = "requests.post(\n  f\"https://api.opensop.dev/sop/webhooks/{callback_id}\",\n  json={\"status\": \"success\"}\n)"
      ruby_req  = 'req = Net::HTTP::Post.new("/sop/webhooks/#{callback_id}")' + "\n" +
                  'req["Content-Type"] = "application/json"' + "\n" +
                  'req.body = { status: "success" }.to_json' + "\n" +
                  'Net::HTTP.start("api.opensop.dev", use_ssl: true) { |h| h.request(req) }'
      resp_body = "{\n  \"received\": true,\n  \"step_id\":   \"verify-kyc\"\n}"
    %>
    <div class="lg:sticky lg:top-16 lg:self-start space-y-4">
      <%= render Ui::ApiDocs::CodePanelComponent.new(tabs: [[:curl, "curl"], [:node, "node"], [:python, "python"], [:ruby, "ruby"]]) do |panel| %>
        <% panel.with_pane(key: :curl).with_content(curl_req) %>
        <% panel.with_pane(key: :node).with_content(node_req) %>
        <% panel.with_pane(key: :python).with_content(py_req) %>
        <% panel.with_pane(key: :ruby).with_content(ruby_req) %>
      <% end %>

      <%= render Ui::ApiDocs::CodePanelComponent.new(status: { code: 200, label: "RESPONSE" }) do |panel| %>
        <% panel.with_body do %><%= resp_body %><% end %>
      <% end %>
    </div>

  </div>
</div>
