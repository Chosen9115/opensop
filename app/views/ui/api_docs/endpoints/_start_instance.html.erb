<%
  endpoint = Ui::ApiDocs::Catalog.endpoint("start-instance")
  section  = Ui::ApiDocs::Catalog.section_for_endpoint("start-instance")
%>
<%= render "ui/api_docs/page_header",
      crumbs: [["api", nil], [section[:label], nil], [t('opensop.api_docs.endpoints.start_instance.title'), nil]],
      title: t('opensop.api_docs.endpoints.start_instance.title'),
      method: endpoint[:method],
      path: endpoint[:path] %>

<div class="px-10 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] gap-12">

    <div class="space-y-6">
      <p class="text-[14px] text-[#5d6470] leading-relaxed"><%= t('opensop.api_docs.endpoints.start_instance.description_html').html_safe %></p>

      <%= render Ui::ApiDocs::CalloutComponent.new(variant: :info, label: "AUTH") do |c| %>
        <% c.with_body do %><%= t('opensop.api_docs.common.auth_callout_html').html_safe %><% end %>
      <% end %>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.path_params') %></h2>
        <dl class="space-y-4">
          <div>
            <dt class="flex items-center gap-2 mb-1">
              <span class="font-mono text-[13px] text-[#0f1115]">name</span>
              <span class="font-mono text-[11px] text-[#5d6470]">string</span>
              <span class="font-mono text-[9px] font-bold uppercase bg-[#fbe9e9] text-[#b03333] rounded-[3px] px-1.5 py-px">REQUIRED</span>
            </dt>
            <dd class="text-[13px] text-[#5d6470]">The process name. Must match an existing published process exactly.</dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.request_body') %></h2>
        <p class="text-[13px] text-[#5d6470] mb-3"><code class="font-mono text-[11px] bg-[#eef0f3] px-1 rounded-[3px]">Content-Type: application/json</code></p>
        <dl class="space-y-4">
          <div>
            <dt class="flex items-center gap-2 mb-1">
              <span class="font-mono text-[13px] text-[#0f1115]">inputs</span>
              <span class="font-mono text-[11px] text-[#5d6470]">object</span>
              <span class="font-mono text-[9px] font-bold uppercase bg-[#fbe9e9] text-[#b03333] rounded-[3px] px-1.5 py-px">REQUIRED</span>
            </dt>
            <dd class="text-[13px] text-[#5d6470]">Key-value map of process inputs. All fields declared as <code class="font-mono text-[11px] bg-[#eef0f3] px-1 rounded-[3px]">required: true</code> in the process definition must be present.</dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.response') %></h2>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#e7f6ec] text-[#0f7a3d]">201</span>
          <span class="text-[13px] text-[#5d6470]">application/json — New instance object with <code class="font-mono text-[11px] bg-[#eef0f3] px-1 rounded-[3px]">id</code> and initial <code class="font-mono text-[11px] bg-[#eef0f3] px-1 rounded-[3px]">state</code>.</span>
        </div>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.errors_heading') %></h2>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">404</span>
          <code class="font-mono text-[12px] text-[#0f1115]">not_found</code>
          <span class="text-[13px] text-[#5d6470]">No published process with that name.</span>
        </div>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">422</span>
          <code class="font-mono text-[12px] text-[#0f1115]">invalid_inputs</code>
          <span class="text-[13px] text-[#5d6470]">One or more inputs failed schema validation.</span>
        </div>
        <div class="flex items-center gap-3 py-3">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">401</span>
          <code class="font-mono text-[12px] text-[#0f1115]">unauthorized</code>
          <span class="text-[13px] text-[#5d6470]">Token missing or revoked.</span>
        </div>
      </div>
    </div>

    <%
      curl_req  = "curl https://api.opensop.dev/sop/customer-onboarding/start \\\n  -X POST \\\n  -H \"X-SOP-Token: $OPENSOP_TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"inputs\":{\"company_name\":\"Acme Corp\",\"country\":\"US\"}}'"
      node_req  = "const res = await fetch(\n  \"https://api.opensop.dev/sop/customer-onboarding/start\",\n  {\n    method: \"POST\",\n    headers: {\n      \"X-SOP-Token\": process.env.OPENSOP_TOKEN,\n      \"Content-Type\": \"application/json\"\n    },\n    body: JSON.stringify({\n      inputs: { company_name: \"Acme Corp\", country: \"US\" }\n    })\n  }\n);\nconst instance = await res.json();"
      py_req    = "resp = requests.post(\n  \"https://api.opensop.dev/sop/customer-onboarding/start\",\n  json={\n    \"inputs\": {\n      \"company_name\": \"Acme Corp\",\n      \"country\": \"US\"\n    }\n  },\n  headers={\"X-SOP-Token\": os.environ[\"OPENSOP_TOKEN\"]}\n)\nprint(resp.json())"
      ruby_req  = "Net::HTTP.start(\"api.opensop.dev\", use_ssl: true) do |h|\n  req = Net::HTTP::Post.new(\"/sop/customer-onboarding/start\")\n  req[\"X-SOP-Token\"]   = ENV[\"OPENSOP_TOKEN\"]\n  req[\"Content-Type\"] = \"application/json\"\n  req.body = { inputs: { company_name: \"Acme Corp\", country: \"US\" } }.to_json\n  puts h.request(req).body\nend"
      req_body  = "{\n  \"inputs\": {\n    \"company_name\": \"Acme Corp\",\n    \"country\":       \"US\"\n  }\n}"
      resp_body = "{\n  \"id\":         \"01HXYZ_ACME_001\",\n  \"process\":    \"customer-onboarding\",\n  \"version\":    \"1.0\",\n  \"state\":      \"running\",\n  \"started_at\": \"2024-01-15T10:30:00Z\"\n}"
    %>
    <div class="lg:sticky lg:top-16 lg:self-start space-y-4">
      <%= render Ui::ApiDocs::CodePanelComponent.new(tabs: [[:curl, "curl"], [:node, "node"], [:python, "python"], [:ruby, "ruby"]]) do |panel| %>
        <% panel.with_pane(key: :curl).with_content(curl_req) %>
        <% panel.with_pane(key: :node).with_content(node_req) %>
        <% panel.with_pane(key: :python).with_content(py_req) %>
        <% panel.with_pane(key: :ruby).with_content(ruby_req) %>
      <% end %>

      <%= render Ui::ApiDocs::CodePanelComponent.new(label: "REQUEST BODY · application/json") do |panel| %>
        <% panel.with_body do %><%= req_body %><% end %>
      <% end %>

      <%= render Ui::ApiDocs::CodePanelComponent.new(status: { code: 201, label: "RESPONSE" }) do |panel| %>
        <% panel.with_body do %><%= resp_body %><% end %>
      <% end %>
    </div>

  </div>
</div>
