<%
  endpoint = Ui::ApiDocs::Catalog.endpoint("register-process")
  section  = Ui::ApiDocs::Catalog.section_for_endpoint("register-process")
%>
<%= render "ui/api_docs/page_header",
      crumbs: [["api", nil], [section[:label], nil], [t('opensop.api_docs.endpoints.register_process.title'), nil]],
      title: t('opensop.api_docs.endpoints.register_process.title'),
      method: endpoint[:method],
      path: endpoint[:path] %>

<div class="px-10 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] gap-12">

    <div class="space-y-6">
      <p class="text-[14px] text-[#5d6470] leading-relaxed"><%= t('opensop.api_docs.endpoints.register_process.description') %></p>

      <%= render Ui::ApiDocs::CalloutComponent.new(variant: :info, label: "AUTH") do |c| %>
        <% c.with_body do %><%= t('opensop.api_docs.common.auth_callout_html').html_safe %><% end %>
      <% end %>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.request_body') %></h2>
        <p class="text-[13px] text-[#5d6470] mb-3">Multipart form upload. <code class="font-mono text-[11px] bg-[#eef0f3] px-1 rounded-[3px]">Content-Type: multipart/form-data</code></p>
        <dl class="space-y-4">
          <div>
            <dt class="flex items-center gap-2 mb-1">
              <span class="font-mono text-[13px] text-[#0f1115]">file</span>
              <span class="font-mono text-[11px] text-[#5d6470]">file</span>
              <span class="font-mono text-[9px] font-bold uppercase bg-[#fbe9e9] text-[#b03333] rounded-[3px] px-1.5 py-px">REQUIRED</span>
            </dt>
            <dd class="text-[13px] text-[#5d6470]">The <code class="font-mono text-[11px] bg-[#eef0f3] px-1 rounded-[3px]">.sop.yaml</code> file to register.</dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.response') %></h2>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#e7f6ec] text-[#0f7a3d]">201</span>
          <span class="text-[13px] text-[#5d6470]">application/json — The registered process definition.</span>
        </div>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.errors_heading') %></h2>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">422</span>
          <code class="font-mono text-[12px] text-[#0f1115]">invalid_definition</code>
          <span class="text-[13px] text-[#5d6470]">YAML failed schema or syntax check.</span>
        </div>
        <div class="flex items-center gap-3 py-3">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">401</span>
          <code class="font-mono text-[12px] text-[#0f1115]">unauthorized</code>
          <span class="text-[13px] text-[#5d6470]">Token missing or revoked.</span>
        </div>
      </div>
    </div>

    <%
      curl_req = "curl https://api.opensop.dev/sop/processes/register \\\n  -X POST \\\n  -H \"X-SOP-Token: $OPENSOP_TOKEN\" \\\n  -F \"file=@customer-onboarding.sop.yaml\""
      node_req = "const form = new FormData();\nform.append(\"file\", fs.createReadStream(\"./customer-onboarding.sop.yaml\"));\nawait fetch(\"https://api.opensop.dev/sop/processes/register\", {\n  method: \"POST\",\n  headers: { \"X-SOP-Token\": process.env.OPENSOP_TOKEN },\n  body: form\n});"
      py_req   = "with open(\"customer-onboarding.sop.yaml\", \"rb\") as f:\n  resp = requests.post(\n    \"https://api.opensop.dev/sop/processes/register\",\n    headers={\"X-SOP-Token\": os.environ[\"OPENSOP_TOKEN\"]},\n    files={\"file\": f}\n  )"
      ruby_req = "uri = URI(\"https://api.opensop.dev/sop/processes/register\")\nreq = Net::HTTP::Post.new(uri)\nreq[\"X-SOP-Token\"] = ENV[\"OPENSOP_TOKEN\"]\nreq.set_form([[\"file\", File.open(\"./customer-onboarding.sop.yaml\")]])"
      resp_body = "{\n  \"name\":    \"customer-onboarding\",\n  \"version\": \"1.0\"\n}"
    %>
    <div class="lg:sticky lg:top-16 lg:self-start space-y-4">
      <%= render Ui::ApiDocs::CodePanelComponent.new(tabs: [[:curl, "curl"], [:node, "node"], [:python, "python"], [:ruby, "ruby"]]) do |panel| %>
        <% panel.with_pane(key: :curl).with_content(curl_req) %>
        <% panel.with_pane(key: :node).with_content(node_req) %>
        <% panel.with_pane(key: :python).with_content(py_req) %>
        <% panel.with_pane(key: :ruby).with_content(ruby_req) %>
      <% end %>

      <%= render Ui::ApiDocs::CodePanelComponent.new(status: { code: 201, label: "RESPONSE" }) do |panel| %>
        <% panel.with_body do %><%= resp_body %><% end %>
      <% end %>
    </div>

  </div>
</div>
