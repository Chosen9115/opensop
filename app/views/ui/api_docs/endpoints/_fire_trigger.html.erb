<%
  endpoint = Ui::ApiDocs::Catalog.endpoint("fire-trigger")
  section  = Ui::ApiDocs::Catalog.section_for_endpoint("fire-trigger")
%>
<%= render "ui/api_docs/page_header",
      crumbs: [["api", nil], [section[:label], nil], [t('opensop.api_docs.endpoints.fire_trigger.title'), nil]],
      title: t('opensop.api_docs.endpoints.fire_trigger.title'),
      method: endpoint[:method],
      path: endpoint[:path] %>

<div class="px-10 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] gap-12">

    <div class="space-y-6">
      <p class="text-[14px] text-[#5d6470] leading-relaxed"><%= t('opensop.api_docs.endpoints.fire_trigger.description') %></p>

      <%= render Ui::ApiDocs::CalloutComponent.new(variant: :warn, label: "IMPORTANT") do |c| %>
        <% c.with_body do %>No bearer token. Auth is HMAC — the third party signs the raw request body using the shared secret declared at <code class="font-mono text-[11px] bg-[#fdf3d6] px-1 rounded-[3px]">process.trigger.auth.secret_env</code>. See <a href="/api-docs/guides/authentication" class="underline">Authentication</a>.<% end %>
      <% end %>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.path_params') %></h2>
        <dl class="space-y-4">
          <div>
            <dt class="flex items-center gap-2 mb-1">
              <span class="font-mono text-[13px] text-[#0f1115]">process_name</span>
              <span class="font-mono text-[11px] text-[#5d6470]">string</span>
              <span class="font-mono text-[9px] font-bold uppercase bg-[#fbe9e9] text-[#b03333] rounded-[3px] px-1.5 py-px">REQUIRED</span>
            </dt>
            <dd class="text-[13px] text-[#5d6470]">The process name. The process must declare <code class="font-mono text-[11px] bg-[#eef0f3] px-1 rounded-[3px]">trigger.type: webhook</code>.</dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.response') %></h2>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#e7f6ec] text-[#0f7a3d]">201</span>
          <span class="text-[13px] text-[#5d6470]">application/json — New instance object.</span>
        </div>
      </div>

      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.06em] text-[#9aa0a8] mb-3"><%= t('opensop.api_docs.common.errors_heading') %></h2>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">401</span>
          <code class="font-mono text-[12px] text-[#0f1115]">invalid_signature</code>
          <span class="text-[13px] text-[#5d6470]">HMAC signature did not match.</span>
        </div>
        <div class="flex items-center gap-3 py-3 border-b border-[#eaecef]">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fbe9e9] text-[#b03333]">500</span>
          <code class="font-mono text-[12px] text-[#0f1115]">trigger_misconfigured</code>
          <span class="text-[13px] text-[#5d6470]">Engine env var for HMAC secret is unset.</span>
        </div>
        <div class="flex items-center gap-3 py-3">
          <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#fdf3d6] text-[#946700]">404</span>
          <code class="font-mono text-[12px] text-[#0f1115]">not_found</code>
          <span class="text-[13px] text-[#5d6470]">No process with that name.</span>
        </div>
      </div>
    </div>

    <%
      curl_req  = "curl https://api.opensop.dev/sop/triggers/customer-onboarding \\\n  -X POST \\\n  -H \"Content-Type: application/json\" \\\n  -H \"X-Hub-Signature-256: sha256=<hmac>\" \\\n  -d '{\"data\":{\"company\":\"Acme Corp\",\"country\":\"US\"}}'"
      node_req  = "// Sign the body with your shared secret first\nawait fetch(\n  \"https://api.opensop.dev/sop/triggers/customer-onboarding\",\n  {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      \"X-Hub-Signature-256\": sig\n    },\n    body: payload\n  }\n);"
      py_req    = "requests.post(\n  \"https://api.opensop.dev/sop/triggers/customer-onboarding\",\n  data=body,\n  headers={\n    \"Content-Type\": \"application/json\",\n    \"X-Hub-Signature-256\": sig\n  }\n)"
      ruby_req  = "req = Net::HTTP::Post.new(\"/sop/triggers/customer-onboarding\")\nreq[\"X-Hub-Signature-256\"] = sig\nreq[\"Content-Type\"]        = \"application/json\"\nreq.body = payload\nNet::HTTP.start(\"api.opensop.dev\", use_ssl: true) { |h| h.request(req) }"
      resp_body = "{\n  \"id\":      \"01HXYZ_ACME_002\",\n  \"process\": \"customer-onboarding\",\n  \"state\":   \"running\"\n}"
    %>
    <div class="lg:sticky lg:top-16 lg:self-start space-y-4">
      <%= render Ui::ApiDocs::CodePanelComponent.new(tabs: [[:curl, "curl"], [:node, "node"], [:python, "python"], [:ruby, "ruby"]]) do |panel| %>
        <% panel.with_pane(key: :curl).with_content(curl_req) %>
        <% panel.with_pane(key: :node).with_content(node_req) %>
        <% panel.with_pane(key: :python).with_content(py_req) %>
        <% panel.with_pane(key: :ruby).with_content(ruby_req) %>
      <% end %>

      <%= render Ui::ApiDocs::CodePanelComponent.new(status: { code: 201, label: "RESPONSE" }) do |panel| %>
        <% panel.with_body do %><%= resp_body %><% end %>
      <% end %>
    </div>

  </div>
</div>
