<%# Markdown endpoint dispatcher — renders the per-slug partial. %>
<% partial_name = "ui/api_docs/endpoints/#{@endpoint[:slug].underscore}" %>
<% if lookup_context.exists?(partial_name, [], true, [], formats: [ :md ]) -%>
<%= render partial: partial_name, formats: [ :md ] %>
<% else -%>
# `<%= @endpoint[:method] %> <%= @endpoint[:path] %>`

> Markdown content for endpoint `<%= @endpoint[:slug] %>` is pending — see the
> HTML version at /api-docs/endpoints/<%= @endpoint[:slug] %> for now.
<% end -%>
