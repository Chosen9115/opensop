<%= render "ui/api_docs/page_header",
      crumbs: [["api", nil], ["versioning", nil]],
      title: t('opensop.api_docs.guides.versioning.title'),
      subtitle: t('opensop.api_docs.guides.versioning.subtitle') %>

<div class="px-10 py-8 max-w-3xl space-y-10">

  <%# API version %>
  <section>
    <h2 class="text-[18px] font-semibold text-[#0f1115] mb-3"><%= t('opensop.api_docs.guides.versioning.api_version.heading') %></h2>
    <p class="text-[14px] text-[#5d6470] leading-relaxed mb-4"><%= t('opensop.api_docs.guides.versioning.api_version.body') %></p>

    <table class="w-full text-left border-collapse">
      <thead>
        <tr>
          <th class="font-mono text-[10px] uppercase tracking-[0.06em] text-[#9aa0a8] py-3 px-4 border-b border-[#eaecef]"><%= t('opensop.api_docs.guides.versioning.api_version.col_version') %></th>
          <th class="font-mono text-[10px] uppercase tracking-[0.06em] text-[#9aa0a8] py-3 px-4 border-b border-[#eaecef]"><%= t('opensop.api_docs.guides.versioning.api_version.col_status') %></th>
          <th class="font-mono text-[10px] uppercase tracking-[0.06em] text-[#9aa0a8] py-3 px-4 border-b border-[#eaecef]"><%= t('opensop.api_docs.guides.versioning.api_version.col_notes') %></th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-[#eaecef]">
          <td class="font-mono text-[12px] text-[#0f1115] py-3 px-4">0.1</td>
          <td class="py-3 px-4">
            <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#e7f6ec] text-[#0f7a3d]">CURRENT</span>
          </td>
          <td class="text-[13px] text-[#5d6470] py-3 px-4"><%= t('opensop.api_docs.guides.versioning.api_version.v01_notes') %></td>
        </tr>
        <tr>
          <td class="font-mono text-[12px] text-[#0f1115] py-3 px-4">0.2</td>
          <td class="py-3 px-4">
            <span class="font-mono text-[11px] font-semibold rounded-[3px] px-2 py-px bg-[#e3ebfd] text-[#1f4ed8]">PREVIEW</span>
          </td>
          <td class="text-[13px] text-[#5d6470] py-3 px-4"><%= t('opensop.api_docs.guides.versioning.api_version.v02_notes') %></td>
        </tr>
      </tbody>
    </table>
  </section>

  <%# Process versions %>
  <section>
    <h2 class="text-[18px] font-semibold text-[#0f1115] mb-3"><%= t('opensop.api_docs.guides.versioning.process_versions.heading') %></h2>
    <p class="text-[14px] text-[#5d6470] leading-relaxed mb-3"><%= t('opensop.api_docs.guides.versioning.process_versions.semver_html').html_safe %></p>
    <p class="text-[14px] text-[#5d6470] leading-relaxed"><%= t('opensop.api_docs.guides.versioning.process_versions.pin_html').html_safe %></p>
  </section>

</div>
