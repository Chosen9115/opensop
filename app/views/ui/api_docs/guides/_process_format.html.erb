<%= render "ui/api_docs/page_header",
      crumbs: [["api", nil], ["process format", nil]],
      title: t('opensop.api_docs.guides.process_format.title'),
      subtitle: t('opensop.api_docs.guides.process_format.subtitle') %>

<div class="px-10 py-8 max-w-3xl space-y-10">

  <%# Anatomy %>
  <section>
    <h2 class="text-[18px] font-semibold text-[#0f1115] mb-3"><%= t('opensop.api_docs.guides.process_format.anatomy.heading') %></h2>

    <%= render Ui::ApiDocs::CodePanelComponent.new(label: "customer-onboarding.sop.yaml") do |panel| %>
      <% panel.with_body do %><span class="text-[#b6c1d6]">opensop</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">"0.1"</span>
<span class="text-[#b6c1d6]">process</span><span class="text-[#a4abb8]">:</span>
  <span class="text-[#b6c1d6]">name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">customer-onboarding</span>
  <span class="text-[#b6c1d6]">version</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">"1.0"</span>
  <span class="text-[#b6c1d6]">owner</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">banking-team</span>
  <span class="text-[#b6c1d6]">description</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">Onboard a new business customer</span>
  <span class="text-[#b6c1d6]">trigger</span><span class="text-[#a4abb8]">:</span>
    <span class="text-[#b6c1d6]">type</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">api</span>          <span class="text-[#6b7281]"># api | schedule | webhook</span>
  <span class="text-[#b6c1d6]">inputs</span><span class="text-[#a4abb8]">:</span>
    <span class="text-[#a4abb8]">-</span> <span class="text-[#a4abb8]">{</span> <span class="text-[#b6c1d6]">name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">company_name</span><span class="text-[#a4abb8]">,</span> <span class="text-[#b6c1d6]">type</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">string</span><span class="text-[#a4abb8]">,</span> <span class="text-[#b6c1d6]">required</span><span class="text-[#a4abb8]">:</span> <span class="text-[#f1c075]">true</span> <span class="text-[#a4abb8]">}</span>
    <span class="text-[#a4abb8]">-</span> <span class="text-[#a4abb8]">{</span> <span class="text-[#b6c1d6]">name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">country</span><span class="text-[#a4abb8]">,</span> <span class="text-[#b6c1d6]">type</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">enum</span><span class="text-[#a4abb8]">,</span> <span class="text-[#b6c1d6]">values</span><span class="text-[#a4abb8]">:</span> <span class="text-[#a4abb8]">[</span><span class="text-[#c5d99a]">US</span><span class="text-[#a4abb8]">,</span> <span class="text-[#c5d99a]">MX</span><span class="text-[#a4abb8]">],</span> <span class="text-[#b6c1d6]">required</span><span class="text-[#a4abb8]">:</span> <span class="text-[#f1c075]">true</span> <span class="text-[#a4abb8]">}</span>
  <span class="text-[#b6c1d6]">outputs</span><span class="text-[#a4abb8]">:</span>
    <span class="text-[#a4abb8]">-</span> <span class="text-[#a4abb8]">{</span> <span class="text-[#b6c1d6]">name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">account_id</span><span class="text-[#a4abb8]">,</span> <span class="text-[#b6c1d6]">type</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">string</span> <span class="text-[#a4abb8]">}</span>
    <span class="text-[#a4abb8]">-</span> <span class="text-[#a4abb8]">{</span> <span class="text-[#b6c1d6]">name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">status</span><span class="text-[#a4abb8]">,</span> <span class="text-[#b6c1d6]">type</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">enum</span><span class="text-[#a4abb8]">,</span> <span class="text-[#b6c1d6]">values</span><span class="text-[#a4abb8]">:</span> <span class="text-[#a4abb8]">[</span><span class="text-[#c5d99a]">approved</span><span class="text-[#a4abb8]">,</span> <span class="text-[#c5d99a]">rejected</span><span class="text-[#a4abb8]">]</span> <span class="text-[#a4abb8]">}</span>
  <span class="text-[#b6c1d6]">steps</span><span class="text-[#a4abb8]">:</span>
    <span class="text-[#a4abb8]">-</span> <span class="text-[#b6c1d6]">id</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">collect-business-info</span>
      <span class="text-[#b6c1d6]">name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">Collect business information</span>
      <span class="text-[#b6c1d6]">type</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">form</span>          <span class="text-[#6b7281]"># form | automated | judgment | webhook</span>
      <span class="text-[#b6c1d6]">timeout</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">7d</span>
    <span class="text-[#a4abb8]">-</span> <span class="text-[#b6c1d6]">id</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">review-application</span>
      <span class="text-[#b6c1d6]">name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">Review application</span>
      <span class="text-[#b6c1d6]">type</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">judgment</span>
      <span class="text-[#b6c1d6]">judgment</span><span class="text-[#a4abb8]">:</span>
        <span class="text-[#b6c1d6]">allow_agent</span><span class="text-[#a4abb8]">:</span> <span class="text-[#f1c075]">true</span>
        <span class="text-[#b6c1d6]">confidence_threshold</span><span class="text-[#a4abb8]">:</span> <span class="text-[#f1c075]">0.8</span>
        <span class="text-[#b6c1d6]">escalate_to</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">human</span><% end %>
    <% end %>
  </section>

  <%# Step types %>
  <section>
    <h2 class="text-[18px] font-semibold text-[#0f1115] mb-3"><%= t('opensop.api_docs.guides.process_format.step_types.heading') %></h2>
    <table class="w-full text-left border-collapse">
      <thead>
        <tr>
          <th class="font-mono text-[10px] uppercase tracking-[0.06em] text-[#9aa0a8] py-3 px-4 border-b border-[#eaecef]"><%= t('opensop.api_docs.guides.process_format.step_types.col_type') %></th>
          <th class="font-mono text-[10px] uppercase tracking-[0.06em] text-[#9aa0a8] py-3 px-4 border-b border-[#eaecef]"><%= t('opensop.api_docs.guides.process_format.step_types.col_resolved_by') %></th>
          <th class="font-mono text-[10px] uppercase tracking-[0.06em] text-[#9aa0a8] py-3 px-4 border-b border-[#eaecef]"><%= t('opensop.api_docs.guides.process_format.step_types.col_notes') %></th>
        </tr>
      </thead>
      <tbody>
        <% [
          [:form, :form_resolved, :form_notes],
          [:automated, :automated_resolved, :automated_notes],
          [:judgment, :judgment_resolved, :judgment_notes],
          [:webhook, :webhook_resolved, :webhook_notes]
        ].each_with_index do |(type_key, resolved_key, notes_key), idx| %>
          <tr class="<%= idx < 3 ? 'border-b border-[#eaecef]' : '' %>">
            <td class="font-mono text-[12px] text-[#0f1115] py-3 px-4"><%= t("opensop.api_docs.guides.process_format.step_types.#{type_key}") %></td>
            <td class="font-mono text-[12px] text-[#5d6470] py-3 px-4"><%= t("opensop.api_docs.guides.process_format.step_types.#{resolved_key}") %></td>
            <td class="text-[13px] text-[#5d6470] py-3 px-4"><%= t("opensop.api_docs.guides.process_format.step_types.#{notes_key}") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <%# References %>
  <section>
    <h2 class="text-[18px] font-semibold text-[#0f1115] mb-3"><%= t('opensop.api_docs.guides.process_format.references.heading') %></h2>
    <p class="text-[14px] text-[#5d6470] leading-relaxed mb-4"><%= t('opensop.api_docs.guides.process_format.references.body_html').html_safe %></p>

    <%= render Ui::ApiDocs::CodePanelComponent.new(label: "REFERENCES") do |panel| %>
      <% panel.with_body do %><span class="text-[#6b7281]"># Pull a prior step's output into the next step's input</span>
<span class="text-[#b6c1d6]">inputs</span><span class="text-[#a4abb8]">:</span>
  <span class="text-[#b6c1d6]">applicant_name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">"${steps.collect-business-info.outputs.company_name}"</span>

<span class="text-[#6b7281]"># Map a webhook trigger payload field to a process input</span>
<span class="text-[#b6c1d6]">inputs</span><span class="text-[#a4abb8]">:</span>
  <span class="text-[#b6c1d6]">company_name</span><span class="text-[#a4abb8]">:</span> <span class="text-[#c5d99a]">"${trigger.payload.data.company}"</span><% end %>
    <% end %>
  </section>

</div>
