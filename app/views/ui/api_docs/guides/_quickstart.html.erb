<%= render "ui/api_docs/page_header",
      crumbs: [["api", nil], ["quickstart", nil]],
      title: t('opensop.api_docs.guides.quickstart.title'),
      subtitle: t('opensop.api_docs.guides.quickstart.subtitle') %>

<div class="px-10 py-8 max-w-3xl space-y-10">

  <%# What you'll build %>
  <section>
    <h2 class="text-[18px] font-semibold text-[#0f1115] mb-3"><%= t('opensop.api_docs.guides.quickstart.what_you_build.heading') %></h2>
    <p class="text-[14px] text-[#5d6470] leading-relaxed mb-4"><%= t('opensop.api_docs.guides.quickstart.what_you_build.body_html').html_safe %></p>

    <%= render Ui::ApiDocs::CalloutComponent.new(variant: :info, label: "PREREQ") do |c| %>
      <% c.with_body do %><%= t('opensop.api_docs.guides.quickstart.prereq_html').html_safe %><% end %>
    <% end %>
  </section>

  <%# Step 1 — Write the YAML %>
  <section>
    <div class="flex items-start gap-4">
      <div class="shrink-0 w-7 h-7 bg-[#0f1115] rounded-[3px] flex items-center justify-center">
        <span class="text-white text-[13px] font-semibold">1</span>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-[14px] font-semibold text-[#0f1115] mb-1"><%= t('opensop.api_docs.guides.quickstart.step_1.heading') %></h3>
        <p class="text-[13px] text-[#5d6470] mb-3"><%= t('opensop.api_docs.guides.quickstart.step_1.body') %></p>
        <%
          yaml_content = <<~YAML
            opensop: "0.1"
            process:
              name: hello-world
              version: "1.0"
              description: A trivial process
              inputs:
                - { name: who, type: string, required: true }
              outputs:
                - { name: greeting, type: string }
              steps:
                - id: greet
                  type: automated
                  run: ./greet.py
                  outputs:
                    - { name: greeting, value: "Hello, ${inputs.who}!" }
          YAML
        %>
        <%= render Ui::ApiDocs::CodePanelComponent.new(label: "hello-world.yaml") do |panel| %>
          <% panel.with_body do %><%= yaml_content %><% end %>
        <% end %>
      </div>
    </div>
  </section>

  <%# Step 2 — Register the process %>
  <section>
    <div class="flex items-start gap-4">
      <div class="shrink-0 w-7 h-7 bg-[#0f1115] rounded-[3px] flex items-center justify-center">
        <span class="text-white text-[13px] font-semibold">2</span>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-[14px] font-semibold text-[#0f1115] mb-1"><%= t('opensop.api_docs.guides.quickstart.step_2.heading') %></h3>
        <p class="text-[13px] text-[#5d6470] mb-3"><%= t('opensop.api_docs.guides.quickstart.step_2.body') %></p>
        <%
          curl_register = <<~CURL
            curl https://api.opensop.dev/sop/processes/register \\
              -X POST \\
              -H "X-SOP-Token: $OPENSOP_TOKEN" \\
              -F "file=@hello-world.yaml"
          CURL
          curl_register_node = <<~NODE
            const form = new FormData();
            form.append("file", fs.createReadStream("./hello-world.yaml"));
            await fetch("https://api.opensop.dev/sop/processes/register", {
              method: "POST",
              headers: { "X-SOP-Token": process.env.OPENSOP_TOKEN },
              body: form
            });
          NODE
        %>
        <%= render Ui::ApiDocs::CodePanelComponent.new(tabs: [[:curl, "curl"], [:node, "node"]]) do |panel| %>
          <% panel.with_pane(key: :curl).with_content(curl_register) %>
          <% panel.with_pane(key: :node).with_content(curl_register_node) %>
        <% end %>
      </div>
    </div>
  </section>

  <%# Step 3 — Start an instance %>
  <section>
    <div class="flex items-start gap-4">
      <div class="shrink-0 w-7 h-7 bg-[#0f1115] rounded-[3px] flex items-center justify-center">
        <span class="text-white text-[13px] font-semibold">3</span>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-[14px] font-semibold text-[#0f1115] mb-1"><%= t('opensop.api_docs.guides.quickstart.step_3.heading') %></h3>
        <p class="text-[13px] text-[#5d6470] mb-3"><%= t('opensop.api_docs.guides.quickstart.step_3.body') %></p>
        <%
          curl_start = <<~CURL
            curl https://api.opensop.dev/sop/hello-world/start \\
              -X POST \\
              -H "X-SOP-Token: $OPENSOP_TOKEN" \\
              -H "Content-Type: application/json" \\
              -d '{"inputs":{"who":"world"}}'
          CURL
          node_start = <<~NODE
            const res = await fetch("https://api.opensop.dev/sop/hello-world/start", {
              method: "POST",
              headers: {
                "X-SOP-Token": process.env.OPENSOP_TOKEN,
                "Content-Type": "application/json"
              },
              body: JSON.stringify({ inputs: { who: "world" } })
            });
            const instance = await res.json();
          NODE
        %>
        <%= render Ui::ApiDocs::CodePanelComponent.new(tabs: [[:curl, "curl"], [:node, "node"]]) do |panel| %>
          <% panel.with_pane(key: :curl).with_content(curl_start) %>
          <% panel.with_pane(key: :node).with_content(node_start) %>
        <% end %>
      </div>
    </div>
  </section>

  <%# Step 4 — Poll for completion %>
  <section>
    <div class="flex items-start gap-4">
      <div class="shrink-0 w-7 h-7 bg-[#0f1115] rounded-[3px] flex items-center justify-center">
        <span class="text-white text-[13px] font-semibold">4</span>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-[14px] font-semibold text-[#0f1115] mb-1"><%= t('opensop.api_docs.guides.quickstart.step_4.heading') %></h3>
        <p class="text-[13px] text-[#5d6470] mb-3"><%= t('opensop.api_docs.guides.quickstart.step_4.body_html').html_safe %></p>
        <%
          curl_poll = <<~CURL
            curl https://api.opensop.dev/sop/hello-world/:id \\
              -H "X-SOP-Token: $OPENSOP_TOKEN"
          CURL
          node_poll = <<~NODE
            // Poll until state is "completed" or "failed"
            const check = async (id) => {
              const r = await fetch(
                `https://api.opensop.dev/sop/hello-world/${id}`,
                { headers: { "X-SOP-Token": process.env.OPENSOP_TOKEN } }
              );
              return r.json();
            };
          NODE
        %>
        <%= render Ui::ApiDocs::CodePanelComponent.new(tabs: [[:curl, "curl"], [:node, "node"]]) do |panel| %>
          <% panel.with_pane(key: :curl).with_content(curl_poll) %>
          <% panel.with_pane(key: :node).with_content(node_poll) %>
        <% end %>
      </div>
    </div>
  </section>

  <%# Lifecycle diagram %>
  <section>
    <h2 class="text-[18px] font-semibold text-[#0f1115] mb-4"><%= t('opensop.api_docs.guides.quickstart.lifecycle.heading') %></h2>
    <div class="border border-[#eaecef] rounded-[4px] p-6 bg-[#f7f8fa] flex items-center justify-center">
      <svg width="540" height="80" viewBox="0 0 540 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Instance lifecycle state machine">
        <rect x="2" y="24" width="72" height="28" rx="4" stroke="#d5d8de" stroke-width="1" fill="white"/>
        <text x="38" y="42" font-family="JetBrains Mono, monospace" font-size="11" fill="#0f1115" text-anchor="middle">pending</text>
        <line x1="74" y1="38" x2="100" y2="38" stroke="#9aa0a8" stroke-width="1.5" marker-end="url(#arr)"/>
        <rect x="102" y="24" width="72" height="28" rx="4" stroke="#d5d8de" stroke-width="1" fill="white"/>
        <text x="138" y="42" font-family="JetBrains Mono, monospace" font-size="11" fill="#0f1115" text-anchor="middle">running</text>
        <line x1="174" y1="38" x2="200" y2="38" stroke="#9aa0a8" stroke-width="1.5" marker-end="url(#arr)"/>
        <rect x="202" y="24" width="72" height="28" rx="4" stroke="#d5d8de" stroke-width="1" fill="white"/>
        <text x="238" y="42" font-family="JetBrains Mono, monospace" font-size="11" fill="#0f1115" text-anchor="middle">waiting</text>
        <path d="M274 52 Q306 68 306 52 Q306 38 274 38" stroke="#9aa0a8" stroke-width="1.5" fill="none" marker-end="url(#arr)" stroke-dasharray="4 2"/>
        <line x1="310" y1="38" x2="336" y2="38" stroke="#9aa0a8" stroke-width="1.5" marker-end="url(#arr)"/>
        <rect x="338" y="24" width="82" height="28" rx="4" stroke="#0f7a3d" stroke-width="1.5" fill="white"/>
        <text x="379" y="42" font-family="JetBrains Mono, monospace" font-size="11" fill="#0f1115" text-anchor="middle">completed</text>
        <path d="M138 52 Q138 70 240 70 Q342 70 342 52" stroke="#b03333" stroke-width="1.5" fill="none" stroke-dasharray="4 2" marker-end="url(#arrerr)"/>
        <text x="240" y="68" font-family="Inter, sans-serif" font-size="10" fill="#b03333" text-anchor="middle" dy="-2">on error</text>
        <rect x="424" y="24" width="60" height="28" rx="4" stroke="#d5d8de" stroke-width="1" fill="white"/>
        <text x="454" y="42" font-family="JetBrains Mono, monospace" font-size="11" fill="#b03333" text-anchor="middle">failed</text>
        <line x1="420" y1="38" x2="424" y2="38" stroke="#9aa0a8" stroke-width="1" stroke-dasharray="3 2"/>
        <defs>
          <marker id="arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#9aa0a8"/>
          </marker>
          <marker id="arrerr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#b03333"/>
          </marker>
        </defs>
      </svg>
    </div>
  </section>

  <%# Next steps %>
  <section>
    <h2 class="text-[18px] font-semibold text-[#0f1115] mb-3"><%= t('opensop.api_docs.guides.quickstart.next_steps.heading') %></h2>
    <ul class="space-y-2 list-disc list-outside pl-5">
      <li class="text-[14px] text-[#5d6470]"><%= t('opensop.api_docs.guides.quickstart.next_steps.judgment_html').html_safe %></li>
      <li class="text-[14px] text-[#5d6470]"><%= t('opensop.api_docs.guides.quickstart.next_steps.webhook_html').html_safe %></li>
      <li class="text-[14px] text-[#5d6470]"><%= t('opensop.api_docs.guides.quickstart.next_steps.polling') %></li>
    </ul>
  </section>

</div>
