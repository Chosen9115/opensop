<% partial_name = "ui/api_docs/guides/#{@guide[:slug].underscore}" %>
<% if lookup_context.exists?(partial_name, [], true) %>
  <%= render partial: partial_name %>
<% else %>
  <%= render "ui/api_docs/page_header",
        crumbs: [["api", nil], ["guides", nil], [@guide[:label], nil]],
        title: @guide[:label] %>

  <div class="px-10 py-8">
    <p class="text-[#5d6470] text-[14px]">TODO: Content for "<%= @guide[:label] %>" (Phase 2)</p>
  </div>
<% end %>
