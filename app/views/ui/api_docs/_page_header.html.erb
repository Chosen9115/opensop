<%# Page header partial for all API reference pages.
#
# Locals:
#   crumbs:   Array of [label, href_or_nil] pairs for the breadcrumb
#   title:    String — H1 text
#   subtitle: String (optional) — prose description below title
#   method:   String (optional) — HTTP method badge, e.g. "GET"
#   path:     String (optional) — endpoint path, e.g. "/sop/"
%>
<%
  crumbs   ||= []
  title    ||= ""
  subtitle ||= nil
  method   ||= nil
  path     ||= nil
%>

<div class="px-10 pt-8 pb-0">
  <%# Breadcrumb %>
  <% if crumbs.any? %>
    <nav class="flex items-center gap-1 mb-4">
      <% crumbs.each_with_index do |(label, href), idx| %>
        <% unless idx == 0 %>
          <span class="font-mono text-[11px] text-[#d5d8de] mx-0.5">/</span>
        <% end %>
        <% if href %>
          <%= link_to label, href, class: "font-mono text-[11px] text-[#9aa0a8] hover:text-[#5d6470] transition-colors" %>
        <% else %>
          <span class="font-mono text-[11px] text-[#9aa0a8]"><%= label %></span>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <%# H1 %>
  <h1 class="text-[28px] font-semibold text-[#0f1115] leading-tight mb-3"><%= title %></h1>

  <%# Method badge + path (endpoint pages only) %>
  <% if method.present? && path.present? %>
    <%
      badge_colors = case method
                     when "GET"    then "bg-[#e3ebfd] text-[#1f4ed8]"
                     when "POST"   then "bg-[#e7f6ec] text-[#0f7a3d]"
                     when "DELETE" then "bg-[#fbe9e9] text-[#b03333]"
                     when "PATCH"  then "bg-[#fdf3d6] text-[#946700]"
                     else               "bg-[#eef0f3] text-[#5d6470]"
                     end
    %>
    <div class="flex items-center gap-2 mb-3">
      <span class="font-mono text-[10px] font-semibold rounded-[3px] px-2 py-[3px] <%= badge_colors %>"><%= method %></span>
      <code class="font-mono text-[14px] text-[#0f1115]"><%= path %></code>
    </div>
  <% end %>

  <%# Subtitle / description %>
  <% if subtitle.present? %>
    <p class="text-[14px] text-[#5d6470] max-w-prose mb-6"><%= subtitle %></p>
  <% end %>

  <div class="border-b border-border mt-6 mb-0"></div>
</div>
