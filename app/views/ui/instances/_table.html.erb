<% show_actions = local_assigns.fetch(:show_actions, true) %>
<% grid_cols = show_actions ? "grid-cols-[200px_1fr_120px_120px_140px_60px]" : "grid-cols-[200px_1fr_120px_120px_140px]" %>

<div class="border border-border rounded-[3px] divide-y divide-border bg-bg overflow-hidden">
  <div class="grid <%= grid_cols %> gap-4 px-4 py-2 text-[10px] font-mono uppercase tracking-[0.08em] text-fg-muted bg-bg-sunken">
    <span><%= t('opensop.instances.table.instance') %></span>
    <span><%= t('opensop.instances.table.process') %></span>
    <span><%= t('opensop.instances.table.state') %></span>
    <span><%= t('opensop.instances.table.age') %></span>
    <span><%= t('opensop.instances.table.started') %></span>
    <% if show_actions %><span class="text-right"><%= t('opensop.instances.table.actions') %></span><% end %>
  </div>

  <% instances.each do |instance| %>
    <% identifier = instance.metadata.is_a?(Hash) ? instance.metadata["company_name"].presence : nil %>
    <%= link_to ui_instance_path(instance), class: "grid #{grid_cols} gap-4 items-center px-4 py-2.5 hover:bg-bg-hover transition-colors" do %>
      <div class="min-w-0">
        <div class="font-mono text-[12px] text-fg truncate"><%= instance.id.to_s.first(8) %></div>
        <% if identifier %>
          <div class="text-[11px] text-fg-muted truncate"><%= identifier %></div>
        <% end %>
      </div>
      <div class="min-w-0">
        <div class="font-mono text-[12px] text-fg truncate"><%= instance.process_name %></div>
        <div class="font-mono text-[10px] text-fg-faint">v<%= instance.process_version %></div>
      </div>
      <div>
        <%= render PillComponent.new(state: instance.state.to_s) %>
      </div>
      <div class="text-[11px] text-fg-muted font-mono">
        <% if instance.created_at %><%= time_ago_in_words(instance.created_at) %> ago<% end %>
      </div>
      <div class="text-[11px] text-fg-faint font-mono">
        <%= instance.created_at&.strftime("%b %-d, %H:%M") %>
      </div>
      <% if show_actions %>
        <div class="text-right text-[11px] text-fg-muted font-mono">View &rarr;</div>
      <% end %>
    <% end %>
  <% end %>
</div>
