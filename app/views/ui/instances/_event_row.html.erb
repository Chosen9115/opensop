<% # locals: event %>
<li class="grid grid-cols-[120px_1fr_140px] gap-3 px-4 py-2 hover:bg-bg-hover items-start">
  <div class="text-[10px] font-mono text-fg-faint tabular-nums"><%= event.created_at.strftime("%b %-d %H:%M:%S") %></div>
  <div class="min-w-0">
    <div class="font-mono text-[11px] text-fg"><%= event.event_type %></div>
    <% if event.actor.present? || event.step_id.present? %>
      <div class="mt-0.5 text-[10px] text-fg-faint flex flex-wrap items-center gap-x-2">
        <% if event.actor.present? %>
          <span>by <code class="font-mono text-fg-muted"><%= event.actor %></code></span>
        <% end %>
        <% if event.step_id.present? %>
          <span>step <code class="font-mono text-fg-muted"><%= event.step_id %></code></span>
        <% end %>
      </div>
    <% end %>
    <% if event.data.present? %>
      <pre class="mt-1 text-[10px] font-mono text-fg-muted bg-bg-sunken border border-border rounded-[3px] p-2 overflow-x-auto whitespace-pre"><%= JSON.pretty_generate(event.data) %></pre>
    <% end %>
  </div>
  <div class="text-[10px] font-mono text-fg-faint text-right"><%= time_ago_in_words(event.created_at) %> ago</div>
</li>
