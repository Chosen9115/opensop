<% instance_active = %w[pending running].include?(@instance.state) %>
<% process_definition = @process&.definition&.dig("process") || {} %>
<% step_defs_by_id = (process_definition["steps"] || []).index_by { |s| s["id"] } %>
<% identifier = @instance.metadata.is_a?(Hash) ? @instance.metadata["company_name"].presence : nil %>

<section class="mb-6">
  <nav class="mb-2 font-mono text-[11px] text-fg-muted" aria-label="Breadcrumb">
    <%= link_to t('opensop.nav.instances'), ui_instances_path, class: "hover:text-fg" %>
    <span class="mx-1 text-fg-faint">/</span>
    <span class="text-fg"><%= @instance.id.to_s.first(8) %></span>
  </nav>

  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div class="min-w-0">
      <h1 class="text-[20px] font-semibold text-fg">
        <%= t('opensop.instances.show.heading', process_name: @instance.process_name, process_version: @instance.process_version) %>
      </h1>
      <div class="mt-1 flex items-center gap-2 flex-wrap">
        <%= render PillComponent.new(state: @instance.state, label: t("opensop.instance_state.#{@instance.state}", default: @instance.state.to_s.humanize)) %>
        <% if identifier %>
          <span class="text-[12px] text-fg-muted"><%= identifier %></span>
        <% end %>
        <span class="text-[11px] text-fg-faint">
          <%= t('opensop.instances.show.id_label') %>: <code class="font-mono text-[11px] text-fg-faint"><%= @instance.id %></code>
        </span>
      </div>
    </div>

    <% if instance_active %>
      <%= button_to cancel_ui_instance_path(@instance),
                    method: :post,
                    form: { data: { turbo_confirm: t('opensop.instances.show.cancel_confirm') } },
                    class: "btn-pp btn-pp-sm text-err border-err hover:bg-err-bg" do %>
        <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <%= t('opensop.instances.show.cancel_button') %>
      <% end %>
    <% end %>
  </div>
</section>

<div class="grid grid-cols-3 gap-3 mb-6">
  <div class="rounded-[3px] border border-border bg-bg p-3">
    <div class="pp-section-title"><%= t('opensop.instances.show.started_label') %></div>
    <div class="mt-1 text-[13px] tabular-nums text-fg">
      <%= render TimestampComponent.new(time: @instance.started_at) %>
    </div>
  </div>
  <div class="rounded-[3px] border border-border bg-bg p-3">
    <div class="pp-section-title"><%= t('opensop.instances.show.completed_label') %></div>
    <div class="mt-1 text-[13px] tabular-nums text-fg">
      <%= render TimestampComponent.new(time: @instance.completed_at) %>
    </div>
  </div>
  <div class="rounded-[3px] border border-border bg-bg p-3">
    <div class="pp-section-title"><%= t('opensop.instances.show.duration_label') %></div>
    <div class="mt-1 text-[13px] tabular-nums text-fg">
      <% if @instance.started_at && @instance.completed_at %>
        <%= distance_of_time_in_words(@instance.started_at, @instance.completed_at) %>
      <% elsif @instance.started_at %>
        <%= distance_of_time_in_words(@instance.started_at, Time.current) %>
      <% else %>
        —
      <% end %>
    </div>
  </div>
</div>

<% if @instance.error.present? %>
  <div class="mb-6 rounded-[3px] border border-err/30 bg-err-bg p-3">
    <div class="pp-section-title text-err"><%= t('opensop.instances.show.error_label') %></div>
    <pre class="mt-1 text-[11px] font-mono text-err whitespace-pre-wrap"><%= @instance.error %></pre>
  </div>
<% end %>

<section class="mb-8">
  <h2 class="pp-section-title mb-3"><%= t('opensop.instances.show.inputs_heading') %></h2>
  <%= render KeyValueListComponent.new(items: (@instance.inputs || {})) %>
</section>

<section class="mb-8">
  <h2 class="pp-section-title mb-3"><%= t('opensop.instances.show.steps_heading') %></h2>

  <% if @steps.any? %>
    <ol class="space-y-2">
      <% @steps.each_with_index do |step, idx| %>
        <%= render partial: "ui/instances/step_card",
                   locals: {
                     instance: @instance,
                     step: step,
                     step_definition: step_defs_by_id[step.step_id],
                     index: idx
                   } %>
      <% end %>
    </ol>
  <% else %>
    <div class="rounded-[3px] border border-border bg-bg-sunken p-6 text-center text-[12px] text-fg-muted">
      <%= t('opensop.common.empty_state') %>
    </div>
  <% end %>
</section>

<% if @instance.completed? && @instance.outputs.present? %>
  <section class="mb-8">
    <h2 class="pp-section-title mb-3"><%= t('opensop.instances.show.outputs_heading') %></h2>
    <%= render KeyValueListComponent.new(items: @instance.outputs) %>
  </section>
<% end %>

<section>
  <h2 class="pp-section-title mb-3"><%= t('opensop.instances.show.events_heading') %></h2>

  <% if @events.any? %>
    <ul class="border border-border rounded-[3px] divide-y divide-border bg-bg">
      <% @events.each do |event| %>
        <%= render partial: "ui/instances/event_row", locals: { event: event } %>
      <% end %>
    </ul>
  <% else %>
    <div class="rounded-[3px] border border-border bg-bg-sunken p-6 text-center text-[12px] text-fg-muted">
      <%= t('opensop.common.empty_state') %>
    </div>
  <% end %>
</section>
