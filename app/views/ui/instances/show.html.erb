<% instance_active = %w[pending running].include?(@instance.state) %>
<% process_definition = @process&.definition&.dig("process") || {} %>
<% step_defs_by_id = (process_definition["steps"] || []).index_by { |s| s["id"] } %>
<% identifier = @instance.metadata.is_a?(Hash) ? @instance.metadata["company_name"].presence : nil %>

<section class="mb-6">
  <nav class="mb-2 text-xs" aria-label="Breadcrumb">
    <%= link_to t('opensop.nav.instances'), ui_instances_path, class: "text-slate-500 hover:text-slate-900" %>
    <span class="text-slate-300 mx-1">/</span>
    <span class="text-slate-700 font-medium font-mono"><%= @instance.id.to_s.first(8) %></span>
  </nav>

  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">
        <%= t('opensop.instances.show.heading', process_name: @instance.process_name, process_version: @instance.process_version) %>
      </h1>
      <div class="mt-1 flex items-center gap-2 flex-wrap">
        <%= render StateBadgeComponent.new(state: @instance.state, kind: :instance_state, size: :md) %>
        <% if identifier %>
          <span class="text-sm text-slate-600"><%= identifier %></span>
        <% end %>
        <span class="text-xs text-slate-500">
          <%= t('opensop.instances.show.id_label') %>: <code class="font-mono"><%= @instance.id %></code>
        </span>
      </div>
    </div>

    <% if instance_active %>
      <%= button_to cancel_ui_instance_path(@instance),
                    method: :post,
                    form: { data: { turbo_confirm: t('opensop.instances.show.cancel_confirm') } },
                    class: "inline-flex items-center gap-1 rounded-md bg-rose-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-rose-700 cursor-pointer border-0" do %>
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <%= t('opensop.instances.show.cancel_button') %>
      <% end %>
    <% end %>
  </div>
</section>

<section class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
  <div class="rounded-md border border-slate-200 bg-white p-3">
    <p class="text-[11px] uppercase tracking-wide text-slate-500"><%= t('opensop.instances.show.started_label') %></p>
    <p class="mt-1 text-sm font-medium text-slate-900">
      <%= render TimestampComponent.new(time: @instance.started_at) %>
    </p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-3">
    <p class="text-[11px] uppercase tracking-wide text-slate-500"><%= t('opensop.instances.show.completed_label') %></p>
    <p class="mt-1 text-sm font-medium text-slate-900">
      <%= render TimestampComponent.new(time: @instance.completed_at) %>
    </p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-3">
    <p class="text-[11px] uppercase tracking-wide text-slate-500"><%= t('opensop.instances.show.duration_label') %></p>
    <p class="mt-1 text-sm font-medium text-slate-900 tabular-nums">
      <% if @instance.started_at && @instance.completed_at %>
        <%= distance_of_time_in_words(@instance.started_at, @instance.completed_at) %>
      <% elsif @instance.started_at %>
        <%= distance_of_time_in_words(@instance.started_at, Time.current) %>
      <% else %>
        —
      <% end %>
    </p>
  </div>
</section>

<% if @instance.error.present? %>
  <section class="mb-6 rounded-lg border border-rose-200 bg-rose-50 p-4">
    <p class="text-sm font-semibold text-rose-900"><%= t('opensop.instances.show.error_label') %></p>
    <pre class="mt-1 text-xs text-rose-800 whitespace-pre-wrap font-mono"><%= @instance.error %></pre>
  </section>
<% end %>

<section class="mb-8">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3"><%= t('opensop.instances.show.inputs_heading') %></h2>
  <%= render KeyValueListComponent.new(items: (@instance.inputs || {})) %>
</section>

<section class="mb-8">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3"><%= t('opensop.instances.show.steps_heading') %></h2>

  <% if @steps.any? %>
    <ol class="space-y-3">
      <% @steps.each_with_index do |step, idx| %>
        <%= render partial: "ui/instances/step_card",
                   locals: {
                     instance: @instance,
                     step: step,
                     step_definition: step_defs_by_id[step.step_id],
                     index: idx
                   } %>
      <% end %>
    </ol>
  <% else %>
    <%= render EmptyStateComponent.new(title: t('opensop.instances.show.steps_heading'), description: t('opensop.common.empty_state')) %>
  <% end %>
</section>

<% if @instance.completed? && @instance.outputs.present? %>
  <section class="mb-8">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3"><%= t('opensop.instances.show.outputs_heading') %></h2>
    <%= render KeyValueListComponent.new(items: @instance.outputs) %>
  </section>
<% end %>

<section class="mb-8">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3"><%= t('opensop.instances.show.events_heading') %></h2>

  <% if @events.any? %>
    <ul class="divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white shadow-sm">
      <% @events.each do |event| %>
        <%= render partial: "ui/instances/event_row", locals: { event: event } %>
      <% end %>
    </ul>
  <% else %>
    <%= render EmptyStateComponent.new(title: t('opensop.instances.show.events_heading'), description: t('opensop.common.empty_state')) %>
  <% end %>
</section>
