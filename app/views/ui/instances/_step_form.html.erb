<% # Renders a form that posts step outputs to the submit endpoint.
   # locals: instance, step, step_definition, outputs_schema, mode (:inputs|:approval|:escalated)
%>
<% mode ||= :inputs %>
<% outputs_schema ||= (step_definition && step_definition["outputs"]) || [] %>

<%
  heading_label, heading_pill_state =
    case mode
    when :approval  then [t('opensop.steps.form.approval_heading'),  :ok]
    when :escalated then [t('opensop.steps.form.escalated_heading'), :warn]
    else                 [t('opensop.steps.form.waiting_heading'),   :info]
    end
%>

<%= form_with url: ui_instance_submit_step_path(instance_id: instance.id, step_id: step.step_id),
              method: :post,
              local: true,
              data: { turbo: false },
              class: "mt-4 space-y-4 rounded-[3px] border border-border bg-bg-sunken p-4" do |f| %>

  <div>
    <%= render PillComponent.new(state: heading_pill_state, label: heading_label) %>
  </div>

  <% case mode %>
  <% when :approval %>
    <p class="text-[12px] text-fg-muted"><%= t('opensop.steps.form.fill_outputs') %></p>
    <div class="flex items-center gap-2">
      <button type="submit"
              name="outputs[approved]"
              value="true"
              class="btn-pp btn-pp-primary btn-pp-sm">
        <%= t('opensop.steps.form.approve_button') %>
      </button>
      <button type="submit"
              name="outputs[approved]"
              value="false"
              class="btn-pp btn-pp-ghost btn-pp-sm text-err border-err hover:bg-err-bg">
        <%= t('opensop.steps.form.reject_button') %>
      </button>
    </div>
  <% else %>
    <p class="text-[12px] text-fg-muted"><%= t('opensop.steps.form.fill_outputs') %></p>

    <% outputs_schema.each do |out| %>
      <% field_name = out["name"] %>
      <% field_type = out["type"] || "string" %>
      <% input_id   = "outputs_#{field_name}" %>

      <div>
        <label for="<%= input_id %>" class="text-[11px] font-medium mb-1 block text-fg">
          <%= field_name %>
          <span class="ml-1 font-mono text-fg-faint text-[10px]">(<%= field_type %>)</span>
        </label>

        <% case field_type.to_s %>
        <% when "boolean" %>
          <div class="flex items-center gap-2">
            <input type="hidden" name="outputs[<%= field_name %>]" value="false" />
            <input type="checkbox"
                   id="<%= input_id %>"
                   name="outputs[<%= field_name %>]"
                   value="true"
                   class="h-4 w-4 rounded-[3px] border border-border bg-bg text-info focus:border-border-focus focus:outline-none" />
            <span class="text-[11px] text-fg-muted"><%= t('opensop.common.yes') %>/<%= t('opensop.common.no') %></span>
          </div>
        <% when "number", "integer" %>
          <input type="number"
                 step="any"
                 id="<%= input_id %>"
                 name="outputs[<%= field_name %>]"
                 class="w-full rounded-[3px] border border-border bg-bg px-2 py-1 text-[12px] focus:border-border-focus focus:outline-none" />
        <% when "enum" %>
          <select id="<%= input_id %>"
                  name="outputs[<%= field_name %>]"
                  class="w-full rounded-[3px] border border-border bg-bg px-2 py-1 text-[12px] focus:border-border-focus focus:outline-none">
            <option value=""></option>
            <% Array(out["values"]).each do |v| %>
              <option value="<%= v %>"><%= v %></option>
            <% end %>
          </select>
        <% when "object", "string[]", "array" %>
          <textarea id="<%= input_id %>"
                    name="outputs[<%= field_name %>]"
                    rows="4"
                    placeholder='{"key": "value"}'
                    class="w-full rounded-[3px] border border-border bg-bg px-2 py-1 text-[12px] font-mono focus:border-border-focus focus:outline-none"></textarea>
          <p class="mt-1 text-fg-faint text-[10px]">JSON</p>
        <% else %>
          <input type="text"
                 id="<%= input_id %>"
                 name="outputs[<%= field_name %>]"
                 class="w-full rounded-[3px] border border-border bg-bg px-2 py-1 text-[12px] focus:border-border-focus focus:outline-none" />
        <% end %>

        <% if out["description"].present? %>
          <p class="mt-1 text-fg-faint text-[10px]"><%= out["description"] %></p>
        <% end %>
      </div>
    <% end %>

    <div class="flex items-center gap-2 pt-2">
      <%= f.submit t('opensop.steps.form.submit_button'),
                   class: "btn-pp btn-pp-primary btn-pp-sm cursor-pointer" %>
    </div>
  <% end %>
<% end %>
