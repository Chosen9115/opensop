<% # locals: instance, step, step_definition, index %>
<%
  pill_state =
    case step.state
    when "completed" then "ok"
    when "failed"    then "err"
    when "skipped"   then "neutral"
    when "pending"   then "neutral"
    else
      if step.sub_state == "escalated" || step.sub_state.to_s.start_with?("waiting_")
        "warn"
      else
        "info"
      end
    end

  pill_label =
    if step.sub_state.present? && step.state == "active"
      I18n.t("opensop.steps.sub_state.#{step.sub_state}", default: step.sub_state.to_s.humanize)
    else
      I18n.t("opensop.steps.state.#{step.state}", default: step.state.to_s.humanize)
    end
%>
<li id="step-<%= step.step_id %>" class="rounded-[3px] border border-border bg-bg p-4">
  <div class="flex items-start gap-3">
    <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-border bg-bg-sunken font-mono text-[11px] tabular-nums text-fg-muted">
      <%= index + 1 %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="text-[13px] font-semibold text-fg"><%= step.step_name || step.step_id %></h3>
        <code class="font-mono text-[10px] text-fg-faint"><%= step.step_id %></code>
        <%= render PillComponent.new(state: pill_state, label: pill_label) %>
        <% if step.step_type.present? %>
          <span class="pp-tag"><%= I18n.t("opensop.steps.type.#{step.step_type}", default: step.step_type.to_s.humanize) %></span>
        <% end %>
        <% if step.attempt.to_i > 1 %>
          <span class="text-[11px] text-fg-muted"><%= t('opensop.steps.summary.attempt', attempt: step.attempt) %></span>
        <% end %>
      </div>

      <% if step_definition && step_definition["description"].present? %>
        <p class="mt-1 text-[12px] text-fg-muted"><%= step_definition["description"] %></p>
      <% end %>

      <% # Timing / decided_by line %>
      <% if step.completed? || step.failed? || step.skipped? %>
        <div class="mt-2 text-[11px] text-fg-muted flex flex-wrap items-center gap-x-3 gap-y-1">
          <% if step.completed_at.present? %>
            <span>
              <span class="text-fg-faint"><%= t('opensop.steps.state.completed') %>:</span>
              <%= render TimestampComponent.new(time: step.completed_at) %>
            </span>
          <% end %>
          <% if step.decided_by.present? %>
            <% who = step.decided_by %>
            <% who_type = who.start_with?("human") ? :human : (who == "agent" ? :agent : :system) %>
            <span>
              <span class="text-fg-faint">by:</span>
              <code class="font-mono text-[11px] text-fg"><%= who %></code>
              <% if who_type == :agent && step.confidence.present? %>
                <span class="ml-1 text-fg-faint">(<%= t('opensop.steps.summary.decided_by_agent', confidence: step.confidence) %>)</span>
              <% end %>
            </span>
          <% end %>
        </div>
      <% end %>

      <% # Active sub-state interaction %>
      <% if step.active? %>
        <% case step.sub_state %>
        <% when "waiting_for_input", "running" %>
          <%= render partial: "ui/instances/step_form",
                     locals: { instance: instance, step: step, step_definition: step_definition, outputs_schema: (step_definition && step_definition["outputs"]) || [], mode: :inputs } %>
        <% when "waiting_for_approval" %>
          <%= render partial: "ui/instances/step_form",
                     locals: { instance: instance, step: step, step_definition: step_definition, outputs_schema: [], mode: :approval } %>
        <% when "escalated" %>
          <div class="mt-3 rounded-[3px] border border-warn/30 bg-warn-bg p-3">
            <div class="pp-section-title text-warn"><%= t('opensop.steps.form.escalated_heading') %></div>
            <% if step.confidence.present? %>
              <p class="mt-1 text-[11px] text-warn"><%= t('opensop.steps.form.escalated_agent_confidence', confidence: step.confidence) %></p>
            <% end %>
          </div>
          <%= render partial: "ui/instances/step_form",
                     locals: { instance: instance, step: step, step_definition: step_definition, outputs_schema: (step_definition && step_definition["outputs"]) || [], mode: :escalated } %>
        <% when "waiting_for_callback" %>
          <div class="mt-3 rounded-[3px] border border-warn/30 bg-warn-bg p-3 text-[12px] text-warn">
            <%= t('opensop.steps.sub_state.waiting_for_callback') %>
            <% if step.started_at %>
              — <span class="text-warn/80">started <%= render TimestampComponent.new(time: step.started_at) %></span>
            <% end %>
          </div>
        <% when "waiting_for_condition", "waiting_for_subprocess" %>
          <div class="mt-3 rounded-[3px] border border-warn/30 bg-warn-bg p-3 text-[12px] text-warn">
            <%= t("opensop.steps.sub_state.#{step.sub_state}") %>
          </div>
        <% end %>
      <% end %>

      <% if step.failed? %>
        <div class="mt-3 rounded-[3px] border border-err/30 bg-err-bg p-3">
          <div class="pp-section-title text-err"><%= t('opensop.steps.state.failed') %></div>
          <% if step.error.present? %>
            <div class="relative mt-1">
              <% if @step_debug_prompts.is_a?(Hash) && @step_debug_prompts[step.id].present? %>
                <button type="button"
                        data-controller="copy-prompt"
                        data-copy-prompt-text-value="<%= @step_debug_prompts[step.id] %>"
                        data-action="click->copy-prompt#copy"
                        aria-label="<%= t('opensop.instances.show.copy_debug.aria_label') %>"
                        class="absolute right-1 top-1 inline-flex items-center gap-1 rounded-[3px] border border-err/30 bg-err-bg px-1.5 py-0.5 text-[11px] text-err hover:bg-err/10 transition">
                  <span data-copy-prompt-target="defaultIcon" class="inline-flex">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                    </svg>
                  </span>
                  <span data-copy-prompt-target="successIcon" class="hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                  </span>
                  <span data-copy-prompt-target="defaultLabel"><%= t('opensop.instances.show.copy_debug.button_label') %></span>
                  <span data-copy-prompt-target="successLabel" class="hidden"><%= t('opensop.instances.show.copy_debug.copied_label') %></span>
                  <span data-copy-prompt-target="errorLabel" class="hidden"><%= t('opensop.instances.show.copy_debug.error_label') %></span>
                </button>
              <% end %>
              <pre class="mt-1 text-[11px] font-mono text-err whitespace-pre-wrap"><%= step.error %></pre>
            </div>
          <% end %>
          <div class="mt-2">
            <span role="button"
                  aria-disabled="true"
                  title="<%= t('opensop.common.coming_soon') %>"
                  class="btn-pp btn-pp-sm text-fg-faint cursor-not-allowed">
              <%= t('opensop.common.retry') %>
            </span>
          </div>
        </div>
      <% end %>

      <% if step.skipped? %>
        <p class="mt-2 text-[11px] text-fg-faint italic"><%= t('opensop.steps.state.skipped') %></p>
      <% end %>

      <% # Inputs resolved for this step %>
      <% if step.inputs.present? %>
        <div class="mt-3">
          <div class="pp-section-title mb-1"><%= t('opensop.processes.show.inputs') %></div>
          <%= render KeyValueListComponent.new(items: step.inputs) %>
        </div>
      <% end %>

      <% # Outputs %>
      <% if step.outputs.present? %>
        <div class="mt-3">
          <div class="pp-section-title mb-1"><%= t('opensop.processes.show.outputs') %></div>
          <%= render KeyValueListComponent.new(items: step.outputs) %>
        </div>
      <% end %>
    </div>
  </div>
</li>
