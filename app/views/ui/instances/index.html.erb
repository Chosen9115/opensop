<header class="mb-6">
  <h1 class="text-[20px] font-semibold tracking-tight text-fg"><%= t('opensop.instances.title') %></h1>
  <p class="mt-1 text-[12px] text-fg-muted"><%= t('opensop.instances.subtitle') %></p>
</header>

<div class="mb-4 flex items-end gap-2 border-b border-border pb-4">
  <%= form_with url: ui_instances_path, method: :get, local: true, class: "flex items-end gap-2" do |f| %>
    <div>
      <%= f.label :state, t('opensop.instances.filters.state'), class: "block text-[10px] font-mono uppercase tracking-[0.08em] text-fg-muted mb-1" %>
      <%= f.select :state,
                   [
                     [t('opensop.instances.filters.all'), ""],
                     [t('opensop.instance_state.running'),   "running"],
                     [t('opensop.instance_state.pending'),   "pending"],
                     [t('opensop.instance_state.completed'), "completed"],
                     [t('opensop.instance_state.failed'),    "failed"],
                     [t('opensop.instance_state.cancelled'), "cancelled"]
                   ],
                   { selected: @state_filter },
                   class: "rounded-[3px] border border-border bg-bg px-2 py-1 text-[12px] focus:border-border-focus focus:outline-none" %>
    </div>

    <div>
      <%= f.label :process, t('opensop.instances.filters.process'), class: "block text-[10px] font-mono uppercase tracking-[0.08em] text-fg-muted mb-1" %>
      <%= f.select :process,
                   [[t('opensop.instances.filters.all'), ""]] + @process_names.map { |n| [n, n] },
                   { selected: @process_filter },
                   class: "rounded-[3px] border border-border bg-bg px-2 py-1 text-[12px] focus:border-border-focus focus:outline-none" %>
    </div>

    <%= f.submit t('opensop.instances.filters.apply'), class: "btn-pp btn-pp-primary btn-pp-sm" %>
    <%= link_to t('opensop.instances.filters.clear'), ui_instances_path, class: "btn-pp btn-pp-ghost btn-pp-sm" %>
  <% end %>
  <span class="ml-auto text-[11px] font-mono text-fg-muted tabular-nums"><%= @instances.size %> / <%= @total %></span>
</div>

<% if @instances.any? %>
  <%= render partial: "ui/instances/table", locals: { instances: @instances, show_actions: true } %>
<% else %>
  <div class="rounded-[3px] border border-border bg-bg-sunken p-8 text-center text-[12px] text-fg-muted">
    <%= t('opensop.instances.empty') %>
  </div>
<% end %>
