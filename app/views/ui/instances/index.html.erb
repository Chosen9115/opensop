<section class="mb-6">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900"><%= t('opensop.instances.title') %></h1>
  <p class="mt-1 text-sm text-slate-600"><%= t('opensop.instances.subtitle') %></p>
</section>

<section class="mb-6 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
  <%= form_with url: ui_instances_path, method: :get, local: true, class: "flex flex-wrap items-end gap-3" do |f| %>
    <div class="flex-1 min-w-[180px]">
      <%= f.label :state, t('opensop.instances.filters.state'), class: "block text-xs font-medium text-slate-600 mb-1" %>
      <%= f.select :state,
                   [
                     [t('opensop.instances.filters.all'), ""],
                     [t('opensop.instance_state.running'),   "running"],
                     [t('opensop.instance_state.pending'),   "pending"],
                     [t('opensop.instance_state.completed'), "completed"],
                     [t('opensop.instance_state.failed'),    "failed"],
                     [t('opensop.instance_state.cancelled'), "cancelled"]
                   ],
                   { selected: @state_filter },
                   class: "block w-full rounded-md border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500 border px-2 py-1.5" %>
    </div>

    <div class="flex-1 min-w-[180px]">
      <%= f.label :process, t('opensop.instances.filters.process'), class: "block text-xs font-medium text-slate-600 mb-1" %>
      <%= f.select :process,
                   [[t('opensop.instances.filters.all'), ""]] + @process_names.map { |n| [n, n] },
                   { selected: @process_filter },
                   class: "block w-full rounded-md border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500 border px-2 py-1.5" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.submit t('opensop.instances.filters.apply'),
                   class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 cursor-pointer" %>
      <%= link_to t('opensop.instances.filters.clear'),
                  ui_instances_path,
                  class: "inline-flex items-center rounded-md border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    </div>
  <% end %>
</section>

<% if @instances.any? %>
  <div class="mb-3 text-xs text-slate-500 tabular-nums">
    <%= @instances.size %> of <%= @total %>
  </div>
  <%= render partial: "ui/instances/table", locals: { instances: @instances, show_actions: true } %>
<% else %>
  <%= render EmptyStateComponent.new(
        title: t('opensop.instances.title'),
        description: t('opensop.instances.empty')
      ) %>
<% end %>
