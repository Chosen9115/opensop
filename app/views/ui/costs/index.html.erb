<%
  format_cost = ->(cents) { format("$%.3f", cents.to_i / 100.0) }
  format_dollars = ->(cents) { format("$%.2f", cents.to_i / 100.0) }
%>

<section class="mb-8">
  <h1 class="pp-section-title text-2xl font-semibold tracking-tight text-fg">
    <%= t('opensop.costs.title', default: 'Costs') %>
  </h1>
  <p class="mt-1 text-sm text-fg-muted">
    <%= t('opensop.costs.subtitle', default: 'LLM token spend across processes — last 30 days') %>
  </p>
</section>

<section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
  <div class="rounded-[3px] border border-border bg-bg p-4">
    <div class="text-xs uppercase tracking-wide text-fg-muted">
      <%= t('opensop.costs.tiles.spend', default: 'Total spend') %>
    </div>
    <div class="mt-2 text-2xl font-mono tabular-nums text-fg">
      <%= format_dollars.call(@totals[:spend_cents]) %>
    </div>
    <div class="mt-1 text-xs text-fg-muted">
      <%= t('opensop.costs.tiles.window', default: 'last 30 days') %>
    </div>
  </div>

  <div class="rounded-[3px] border border-border bg-bg p-4">
    <div class="text-xs uppercase tracking-wide text-fg-muted">
      <%= t('opensop.costs.tiles.calls', default: 'Calls') %>
    </div>
    <div class="mt-2 text-2xl font-mono tabular-nums text-fg">
      <%= number_with_delimiter(@totals[:calls]) %>
    </div>
    <div class="mt-1 text-xs text-fg-muted">
      <%= t('opensop.costs.tiles.window', default: 'last 30 days') %>
    </div>
  </div>

  <div class="rounded-[3px] border border-border bg-bg p-4">
    <div class="text-xs uppercase tracking-wide text-fg-muted">
      <%= t('opensop.costs.tiles.tokens_in', default: 'Tokens in') %>
    </div>
    <div class="mt-2 text-2xl font-mono tabular-nums text-fg">
      <%= number_with_delimiter(@totals[:tokens_in]) %>
    </div>
    <div class="mt-1 text-xs text-fg-muted">
      <%= t('opensop.costs.tiles.window', default: 'last 30 days') %>
    </div>
  </div>

  <div class="rounded-[3px] border border-border bg-bg p-4">
    <div class="text-xs uppercase tracking-wide text-fg-muted">
      <%= t('opensop.costs.tiles.tokens_out', default: 'Tokens out') %>
    </div>
    <div class="mt-2 text-2xl font-mono tabular-nums text-fg">
      <%= number_with_delimiter(@totals[:tokens_out]) %>
    </div>
    <div class="mt-1 text-xs text-fg-muted">
      <%= t('opensop.costs.tiles.window', default: 'last 30 days') %>
    </div>
  </div>
</section>

<% if @has_activity %>
  <section class="mb-10">
    <div class="flex items-center justify-between mb-3">
      <h2 class="pp-section-title text-lg font-semibold text-fg">
        <%= t('opensop.costs.daily.title', default: 'Daily spend') %>
      </h2>
      <span class="pp-tag text-xs font-mono tabular-nums text-fg-muted">
        <%= t('opensop.costs.daily.peak', default: 'peak') %>
        <%= format_cost.call(@daily_max_cents) %>
      </span>
    </div>

    <div class="rounded-[3px] border border-border bg-bg p-4">
      <div class="flex items-end gap-1 h-28 mb-2">
        <% @daily.each do |bucket| %>
          <%
            cents = bucket[:cost_cents].to_i
            pct = @daily_max_cents.positive? ? ((cents.to_f / @daily_max_cents) * 100).round(2) : 0
            tone_class = cents.positive? ? "bg-info" : "bg-fg-muted/30"
          %>
          <div class="flex-1 flex flex-col justify-end h-full">
            <div
              class="<%= tone_class %> rounded-[3px] min-h-[2px]"
              title="<%= bucket[:date].strftime('%Y-%m-%d') %> — <%= format_cost.call(cents) %>"
              style="height: <%= pct %>%;"
            ></div>
          </div>
        <% end %>
      </div>
      <div class="flex justify-between text-[10px] font-mono tabular-nums text-fg-muted">
        <span><%= @daily.first[:date].strftime('%b %d') %></span>
        <span><%= @daily.last[:date].strftime('%b %d') %></span>
      </div>
    </div>
  </section>

  <section>
    <div class="flex items-center justify-between mb-3">
      <h2 class="pp-section-title text-lg font-semibold text-fg">
        <%= t('opensop.costs.top_steps.title', default: 'Top 10 most expensive steps') %>
      </h2>
    </div>

    <% if @top_steps.any? %>
      <div class="overflow-hidden rounded-[3px] border border-border bg-bg">
        <div class="grid grid-cols-12 gap-2 px-4 py-2.5 text-xs uppercase tracking-wide text-fg-muted bg-bg-sunken border-b border-border">
          <div class="col-span-4"><%= t('opensop.costs.top_steps.step', default: 'Step') %></div>
          <div class="col-span-2"><%= t('opensop.costs.top_steps.instance', default: 'Instance') %></div>
          <div class="col-span-3"><%= t('opensop.costs.top_steps.model', default: 'Model') %></div>
          <div class="col-span-2 text-right"><%= t('opensop.costs.top_steps.cost', default: 'Cost') %></div>
          <div class="col-span-1 text-right"><%= t('opensop.costs.top_steps.calls', default: 'Calls') %></div>
        </div>
        <% @top_steps.each do |row| %>
          <div class="grid grid-cols-12 gap-2 px-4 py-2.5 border-b border-border last:border-b-0 text-sm">
            <div class="col-span-4 font-mono tabular-nums text-fg truncate" title="<%= row[:step_name] %>">
              <%= row[:step_name].presence || "—" %>
            </div>
            <div class="col-span-2 font-mono tabular-nums text-fg-muted" title="<%= row[:instance_id] %>">
              <%= row[:instance_id].to_s.first(8) %>
            </div>
            <div class="col-span-3 text-fg-muted truncate" title="<%= row[:model] %>">
              <%= row[:model] %>
            </div>
            <div class="col-span-2 text-right font-mono tabular-nums text-fg">
              <%= format_cost.call(row[:cost_cents]) %>
            </div>
            <div class="col-span-1 text-right font-mono tabular-nums text-fg-muted">
              <%= row[:calls] %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-[3px] border border-border bg-bg p-6 text-center text-sm text-fg-muted">
        <%= t('opensop.costs.top_steps.empty', default: 'No step-level cost data available yet.') %>
      </div>
    <% end %>
  </section>
<% else %>
  <section>
    <div class="rounded-[3px] border border-border bg-bg p-8 text-center">
      <p class="text-sm text-fg-muted">
        <%= t('opensop.costs.empty', default: 'No LLM calls in the last 30 days.') %>
      </p>
    </div>
  </section>
<% end %>
