<header class="mb-6">
  <h1 class="text-[20px] font-semibold tracking-tight"><%= t('opensop.dashboard.title') %></h1>
  <p class="mt-1 text-[12px] text-fg-muted"><%= t('opensop.dashboard.subtitle') %></p>
</header>

<section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
  <%= link_to ui_instances_path(state: "running"),
        class: "relative block rounded-[3px] border border-border bg-bg p-4 hover:bg-bg-hover transition-colors" do %>
    <span class="absolute top-3 right-3 h-[4px] w-[4px] rounded-full bg-info" aria-hidden="true"></span>
    <div class="pp-section-title"><%= t('opensop.dashboard.stats.running') %></div>
    <div class="mt-2 text-[28px] font-semibold tabular-nums text-fg"><%= @stats[:running] %></div>
  <% end %>

  <%= link_to ui_instances_path(state: "running"),
        class: "relative block rounded-[3px] border border-border bg-bg p-4 hover:bg-bg-hover transition-colors" do %>
    <span class="absolute top-3 right-3 h-[4px] w-[4px] rounded-full bg-warn" aria-hidden="true"></span>
    <div class="pp-section-title"><%= t('opensop.dashboard.stats.waiting') %></div>
    <div class="mt-2 text-[28px] font-semibold tabular-nums text-fg"><%= @stats[:waiting] %></div>
    <p class="mt-1 text-[11px] text-fg-faint"><%= t('opensop.dashboard.stats.waiting_hint') %></p>
  <% end %>

  <%= link_to ui_instances_path(state: "completed"),
        class: "relative block rounded-[3px] border border-border bg-bg p-4 hover:bg-bg-hover transition-colors" do %>
    <span class="absolute top-3 right-3 h-[4px] w-[4px] rounded-full bg-ok" aria-hidden="true"></span>
    <div class="pp-section-title"><%= t('opensop.dashboard.stats.completed') %></div>
    <div class="mt-2 text-[28px] font-semibold tabular-nums text-fg"><%= @stats[:completed] %></div>
  <% end %>

  <%= link_to ui_instances_path(state: "failed"),
        class: "relative block rounded-[3px] border border-border bg-bg p-4 hover:bg-bg-hover transition-colors" do %>
    <span class="absolute top-3 right-3 h-[4px] w-[4px] rounded-full bg-err" aria-hidden="true"></span>
    <div class="pp-section-title"><%= t('opensop.dashboard.stats.failed') %></div>
    <div class="mt-2 text-[28px] font-semibold tabular-nums text-fg"><%= @stats[:failed] %></div>
  <% end %>
</section>

<section>
  <div class="flex items-center justify-between mb-3">
    <h2 class="pp-section-title"><%= t('opensop.dashboard.recent_instances') %></h2>
    <%= link_to t('opensop.dashboard.view_all'), ui_instances_path,
          class: "text-[12px] font-medium text-fg-muted hover:text-fg" %>
  </div>

  <% if @recent_instances.any? %>
    <%= render partial: "ui/instances/table", locals: { instances: @recent_instances, show_actions: false } %>
  <% else %>
    <div class="rounded-[3px] border border-border bg-bg-sunken p-8 text-center text-[12px] text-fg-muted">
      <%= t('opensop.dashboard.no_instances') %>
    </div>
  <% end %>
</section>
