<%
  format_duration = ->(seconds) {
    s = seconds.to_f
    if s >= 60
      format("%d min", (s / 60).round)
    else
      format("%d s", s.round)
    end
  }
  format_pct = ->(rate) { format("%.1f%%", rate.to_f * 100.0) }
%>

<section class="mb-6">
  <h1 class="text-[20px] font-semibold tracking-tight text-fg">
    <%= t('opensop.metrics.title', default: 'Metrics') %>
  </h1>
  <p class="mt-1 text-[12px] text-fg-muted">
    <%= t('opensop.metrics.subtitle', default: 'Process throughput and success — last 24h') %>
  </p>
</section>

<section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
  <% [
    { key: :started,         value: @totals[:instances_started],            tone: 'info',    hint_default: 'Instances created in window.' },
    { key: :completed,       value: @totals[:instances_completed],          tone: 'ok',      hint_default: 'Reached the completed state.' },
    { key: :failed,          value: @totals[:instances_failed],             tone: 'err',     hint_default: 'Reached the failed state.' },
    { key: :completion_rate, value: format_pct.call(@totals[:completion_rate]), tone: 'neutral', hint_default: 'Completed / (completed + failed).' }
  ].each do |tile| %>
    <div class="relative rounded-[3px] border border-border bg-bg p-4">
      <div class="pp-section-title">
        <%= t("opensop.metrics.tiles.#{tile[:key]}", default: tile[:key].to_s.humanize) %>
      </div>
      <div class="mt-2 text-[28px] font-mono tabular-nums text-fg leading-none">
        <%= tile[:value] %>
      </div>
      <div class="mt-2 text-[11px] text-fg-muted">
        <%= t("opensop.metrics.tiles.#{tile[:key]}_hint", default: tile[:hint_default]) %>
      </div>
      <span class="absolute right-3 top-3 h-1.5 w-1.5 rounded-full bg-<%= tile[:tone] %>"></span>
    </div>
  <% end %>
</section>

<section class="mb-8">
  <h2 class="pp-section-title mb-3">
    <%= t('opensop.metrics.duration.title', default: 'Instance duration') %>
  </h2>
  <div class="rounded-[3px] border border-border bg-bg p-4 grid grid-cols-2 gap-6">
    <div>
      <div class="pp-section-title">
        <%= t('opensop.metrics.duration.avg', default: 'Average') %>
      </div>
      <div class="mt-2 text-[28px] font-mono tabular-nums text-fg leading-none">
        <%= format_duration.call(@totals[:avg_duration_seconds]) %>
      </div>
      <div class="mt-2 text-[11px] text-fg-muted">
        <%= t('opensop.metrics.duration.avg_hint', default: 'Mean of completed instances in window.') %>
      </div>
    </div>
    <div>
      <div class="pp-section-title">
        <%= t('opensop.metrics.duration.p95', default: 'P95') %>
      </div>
      <div class="mt-2 text-[28px] font-mono tabular-nums text-fg leading-none">
        <%= format_duration.call(@totals[:p95_duration_seconds]) %>
      </div>
      <div class="mt-2 text-[11px] text-fg-muted">
        <%= t('opensop.metrics.duration.p95_hint', default: '95th percentile — long-tail check.') %>
      </div>
    </div>
  </div>
</section>

<section class="mb-8">
  <div class="flex items-center justify-between mb-3">
    <h2 class="pp-section-title">
      <%= t('opensop.metrics.per_process.title', default: 'Per-process throughput') %>
    </h2>
    <% if @per_process.any? %>
      <span class="text-[11px] font-mono tabular-nums text-fg-muted">
        <%= @per_process.size %>
      </span>
    <% end %>
  </div>

  <% if @per_process.any? %>
    <div class="border border-border rounded-[3px] divide-y divide-border bg-bg overflow-hidden">
      <div class="grid grid-cols-[1fr_80px_100px_100px_100px_100px] gap-4 px-4 py-2 text-[10px] font-mono uppercase tracking-[0.08em] text-fg-muted bg-bg-sunken">
        <span><%= t('opensop.metrics.per_process.process',   default: 'Process') %></span>
        <span><%= t('opensop.metrics.per_process.version',   default: 'Version') %></span>
        <span class="text-right"><%= t('opensop.metrics.per_process.started',   default: 'Started') %></span>
        <span class="text-right"><%= t('opensop.metrics.per_process.completed', default: 'Completed') %></span>
        <span class="text-right"><%= t('opensop.metrics.per_process.failed',    default: 'Failed') %></span>
        <span class="text-right"><%= t('opensop.metrics.per_process.in_flight', default: 'In flight') %></span>
      </div>

      <% @per_process.each do |row| %>
        <div class="grid grid-cols-[1fr_80px_100px_100px_100px_100px] gap-4 items-center px-4 py-2.5 hover:bg-bg-hover transition-colors">
          <span class="font-mono text-[12px] text-fg truncate" title="<%= row[:process_name] %>">
            <%= row[:process_name] %>
          </span>
          <span class="font-mono text-[11px] text-fg-muted truncate">
            v<%= row[:version] %>
          </span>
          <span class="text-right font-mono tabular-nums text-[12px] text-fg">
            <%= row[:started] %>
          </span>
          <span class="text-right font-mono tabular-nums text-[12px] text-ok">
            <%= row[:completed] %>
          </span>
          <span class="text-right font-mono tabular-nums text-[12px] text-err">
            <%= row[:failed] %>
          </span>
          <span class="text-right font-mono tabular-nums text-[12px] text-info">
            <%= row[:in_flight] %>
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render EmptyStateComponent.new(
          title: t('opensop.metrics.per_process.empty_title', default: 'No process activity in the last 24h'),
          description: t('opensop.metrics.per_process.empty_description', default: 'Process throughput appears here once instances are started.')
        ) %>
  <% end %>
</section>

<section>
  <h2 class="pp-section-title mb-3">
    <%= t('opensop.metrics.step_health.title', default: 'Step health (current)') %>
  </h2>
  <div class="rounded-[3px] border border-border bg-bg p-4 flex flex-wrap items-center gap-6">
    <% [
      { key: :pending,   value: @step_health[:pending],   tone: 'info' },
      { key: :active,    value: @step_health[:active],    tone: 'warn' },
      { key: :completed, value: @step_health[:completed], tone: 'ok' },
      { key: :failed,    value: @step_health[:failed],    tone: 'err' },
      { key: :skipped,   value: @step_health[:skipped],   tone: 'neutral' }
    ].each do |row| %>
      <div class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-<%= row[:tone] %>"></span>
        <span class="text-[11px] uppercase tracking-[0.08em] text-fg-muted">
          <%= t("opensop.metrics.step_health.#{row[:key]}", default: row[:key].to_s.humanize) %>
        </span>
        <span class="font-mono tabular-nums text-[12px] text-fg">
          <%= row[:value] %>
        </span>
      </div>
    <% end %>
  </div>
</section>
