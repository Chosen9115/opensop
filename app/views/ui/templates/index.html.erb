<section class="mb-8 flex items-start justify-between gap-4">
  <div>
    <h1 class="pp-section-title text-2xl font-semibold tracking-tight text-fg">
      <%= t('opensop.templates.title', default: 'Templates') %>
    </h1>
    <p class="mt-1 text-sm text-fg-muted">
      <%= t('opensop.templates.subtitle', default: 'Starter process definitions you can copy and customize.') %>
    </p>
  </div>

  <% if @templates.any? %>
    <div class="text-right">
      <p class="text-xs uppercase tracking-wide text-fg-faint">
        <%= t('opensop.templates.count_label', default: 'Available') %>
      </p>
      <p class="text-2xl font-semibold font-mono tabular-nums text-fg"><%= @templates.size %></p>
    </div>
  <% end %>
</section>

<% if @templates.any? %>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <% @templates.each do |template| %>
      <article class="border border-border rounded-[3px] bg-bg p-4 hover:border-border-strong transition-colors">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-sm font-semibold font-mono text-fg truncate">
                <%= template[:name].presence || t('opensop.common.unknown', default: 'unknown') %>
              </h2>
              <span class="text-xs font-mono text-fg-muted">v<%= template[:version].presence || '0' %></span>
              <% if template[:existing_process] %>
                <span class="pp-tag inline-flex items-center rounded-[3px] border border-border bg-bg-sunken px-1.5 py-0.5 text-[11px] font-medium text-fg-muted">
                  <%= t('opensop.templates.already_imported', default: 'imported') %>
                </span>
              <% end %>
            </div>

            <% if template[:description].present? %>
              <p class="mt-1 text-sm text-fg-muted"><%= template[:description] %></p>
            <% end %>

            <p class="mt-2 text-xs font-mono text-fg-faint truncate" title="<%= template[:path] %>">
              <%= template[:path] %>
            </p>

            <dl class="mt-3 flex flex-wrap items-center gap-2">
              <span class="pp-tag inline-flex items-center rounded-[3px] border border-border bg-bg-sunken px-1.5 py-0.5 text-[11px] font-medium text-fg-muted">
                <%= t('opensop.processes.table.steps', default: 'Steps') %>:
                <span class="ml-1 font-mono tabular-nums text-fg"><%= template[:steps_count] %></span>
              </span>
              <span class="pp-tag inline-flex items-center rounded-[3px] border border-border bg-bg-sunken px-1.5 py-0.5 text-[11px] font-medium text-fg-muted">
                <%= t('opensop.processes.show.inputs', default: 'Inputs') %>:
                <span class="ml-1 font-mono tabular-nums text-fg"><%= template[:inputs_count] %></span>
              </span>
              <span class="pp-tag inline-flex items-center rounded-[3px] border border-border bg-bg-sunken px-1.5 py-0.5 text-[11px] font-medium text-fg-muted">
                <%= t('opensop.processes.show.outputs', default: 'Outputs') %>:
                <span class="ml-1 font-mono tabular-nums text-fg"><%= template[:outputs_count] %></span>
              </span>
            </dl>
          </div>

          <div class="flex flex-col items-stretch gap-2 w-36 flex-shrink-0">
            <% if template[:existing_process] %>
              <%= link_to t('opensop.common.view', default: 'View'),
                          ui_process_path(name: template[:name]),
                          class: "btn-pp btn-pp-sm inline-flex justify-center items-center rounded-[3px] border border-border bg-bg px-3 py-1.5 text-sm font-medium text-fg hover:bg-bg-sunken" %>
            <% else %>
              <span class="btn-pp btn-pp-sm inline-flex justify-center items-center rounded-[3px] border border-border bg-bg-sunken px-3 py-1.5 text-sm font-medium text-fg-muted cursor-not-allowed"
                    aria-disabled="true"
                    title="<%= t('opensop.common.coming_soon', default: 'Coming soon') %>">
                <%= t('opensop.templates.use_as_base', default: 'Use as base') %>
              </span>
            <% end %>
          </div>
        </div>

        <details class="mt-3 group">
          <summary class="cursor-pointer text-xs font-medium text-fg-muted hover:text-fg select-none">
            <%= t('opensop.templates.view_yaml', default: 'View YAML') %>
          </summary>
          <pre class="mt-2 max-h-80 overflow-auto rounded-[3px] border border-border bg-bg-sunken p-3 text-xs font-mono text-fg leading-relaxed whitespace-pre-wrap"><%= template[:raw_yaml] %></pre>
        </details>
      </article>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(
        title: t('opensop.templates.empty_title', default: 'No templates available'),
        description: t('opensop.templates.empty_description', default: 'Drop a .sop.yaml file in /processes to start a new template.')
      ) %>
<% end %>
