{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActionItems",
  "description": "Extracted action items from a meeting notes document.",
  "type": "object",
  "required": ["action_items"],
  "properties": {
    "action_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["owner", "task"],
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "description": "Full name of the person responsible for the action."
          },
          "task": {
            "type": "string",
            "description": "A concise description of what must be done."
          }
        }
      }
    }
  },
  "additionalProperties": false
}
