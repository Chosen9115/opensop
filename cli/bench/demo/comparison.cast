[23.370864, "o", "\u001b[1;37m  ═══════════════════════════════════════════════════════════════\u001b[0m\r\n\u001b[1;37m  RESULTS  —  verified from bulletproof-3arm.jsonl (60 runs)\u001b[0m\r\n"]
[23.3709, "o", "\u001b[1;37m  ═══════════════════════════════════════════════════════════════\u001b[0m\r\n\r\n\u001b[1mMetric              skill         json-only       openSOP                                 \u001b[0m\r\n"]
[23.371514, "o", "\u001b[2m──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[23.371568, "o", "\u001b[1mReliability       \u001b[0m  \u001b[0;31m0/10        \u001b[0m  \u001b[0;31m0/10          \u001b[0m  \u001b[0;32m10/10  ✓      \u001b[0m\r\n"]
[23.673528, "o", "\u001b[1mRecall (3 real)   \u001b[0m  \u001b[0;32m3/3         \u001b[0m  \u001b[0;32m3/3           \u001b[0m  \u001b[0;32m3/3             \u001b[0m\r\n"]
[23.975641, "o", "\u001b[1mPhantom items     \u001b[0m  \u001b[0;31m+4 median   \u001b[0m  \u001b[0;31m+4 median     \u001b[0m  \u001b[0;32m+0  ✓         \u001b[0m\r\n"]
[24.2779, "o", "\u001b[1mValid JSON        \u001b[0m  \u001b[0;31m0/10        \u001b[0m  \u001b[0;32m10/10         \u001b[0m  \u001b[0;32m10/10  ✓      \u001b[0m\r\n"]
[24.579787, "o", "\u001b[1mOutput tokens ≈ \u001b[0m  \u001b[0;31m~174        \u001b[0m  \u001b[0;31m~190          \u001b[0m  \u001b[0;32m~69  (2.5× fewer)\u001b[0m\r\n"]
[24.882299, "o", "\u001b[1mSpeed (median)    \u001b[0m  \u001b[2m2.69s       \u001b[0m  "]
[24.882384, "o", "\u001b[2m2.51s         \u001b[0m  \u001b[0;32m1.56s  (1.7× faster)\u001b[0m\r\n"]
[25.185472, "o", "\u001b[1mConsistent on     \u001b[0m  \u001b[2mHaiku+Sonnet\u001b[0m  \u001b[2mHaiku+Sonnet  \u001b[0m  \u001b[0;32mHaiku+Sonnet  ✓\u001b[0m\r\n"]
[25.18607, "o", "\u001b[2m──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[25.186183, "o", "\r\n\u001b[2m  Recall is 3/3 in every arm — the model always finds the real items.\u001b[0m\r\n\u001b[2m  The failure is scope-creep: naive prompts promote informal commitments to action items.\u001b[0m\r\n\u001b[2m  json_only proves format alone doesn't fix it — only the encoded scope rule does.\u001b[0m\r\n"]
[25.988416, "o", "\r\n"]
[25.989081, "o", "\u001b[2m──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
[25.989094, "o", "\u001b[0;36m\u001b[1m"]
[25.9891, "o", "  A process is a file.\r\n"]
[25.989166, "o", "  Declare it, run it, get the same result every time.\r\n                                                — OpenSOP\r\n\u001b[0m\r\n\u001b[2m  opensop.ai  ·  github.com/opensop/opensop\u001b[0m\r\n\r\n"]
