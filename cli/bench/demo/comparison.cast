[0.006164, "o", "\u001b[2J\u001b[H"]
[0.309453, "o", "\r\n\r\n\u001b[1;37m  OpenSOP — same model, same meeting notes.\u001b[0m\r\n\u001b[1;37m  Extract the action items.\u001b[0m\r\n\r\n\u001b[2m  Model: Claude Haiku · 10 runs each arm · recorded from measured runs, not simulated\u001b[0m\r\n\u001b[2m  Source: cli/bench/results/bulletproof-3arm.jsonl (60 runs total: 3 arms × 2 models × 10)\u001b[0m\r\n"]
[0.309502, "o", "\r\n"]
[0.310146, "o", "\u001b[2m──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[3.812214, "o", "\u001b[2J\u001b[H\r\n\u001b[1;33m  ▶ ACT 1  —  Skill-only (naive prompt)\u001b[0m\r\n\r\n"]
[3.812243, "o", "\u001b[2m  Prompt (abbreviated from cli/bench/prompts/raw.txt):\u001b[0m\r\n\r\n\u001b[0;36m  $ cat raw.txt\u001b[0m\r\n"]
[4.214509, "o", "\u001b[2m  Read the following meeting notes and extract all action items.\r\n  For each action item, identify the person responsible (owner)\r\n  and what they need to do (task).\r\n  ...\r\n  List the action items you found.\r\n"]
[4.214537, "o", "\u001b[0m"]
[5.016968, "o", "\r\n"]
[5.017066, "o", "\u001b[2m──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n\u001b[1;33m  Running 3× (recorded from 10 measured haiku runs)...\u001b[0m\r\n"]
[5.618986, "o", "\r\n\u001b[2m  Run 1/3  ·  haiku  ·  2.85s  ·  result:\u001b[0m\r\n"]
[6.021857, "o", "  Action Items:\r\n  1. Bob Navarro — Fix the CSV export race condition\r\n  2. Carol Singh — Complete the WCAG 2.1 AA accessibility audit\r\n  3. Dave Wu — Write integration tests for payments-flow edge cases\r\n\u001b[0;31m"]
[6.021904, "o", "  4. Alice Chen — Raise staging environment as P1 in infrastructure backlog\r\n  5. Bob Navarro — File a planning ticket for the data-grid library upgrade\r\n  6. Alice Chen — Follow up with customers on batch-import escalations\r\n\u001b[0m"]
[6.524078, "o", "\u001b[0;31m\u001b[2m    ^^^^ phantom items — not in ACTION ITEMS section\u001b[0m\r\n"]
[7.425898, "o", "\r\n"]
[7.425994, "o", "\u001b[2m  Run 2/3  ·  haiku  ·  2.96s  ·  result:\u001b[0m\r\n"]
[7.828055, "o", "  Action Items:\r\n  1. Bob Navarro — Fix the CSV export race condition before August 12\r\n  2. Carol Singh — Complete the WCAG 2.1 AA accessibility audit by August 15\r\n  3. Dave Wu — Write additional integration tests for payments-flow\r\n\u001b[0;31m"]
[7.828167, "o", "  4. Alice Chen — Raise the staging environment reliability as a P1 issue\r\n  5. Bob Navarro — File a ticket for the data-grid library upgrade sprint\r\n  6. Carol Singh — Review the UX flow for batch-import edge cases\r\n  7. Alice Chen — Follow up with the two customers on escalations\r\n  8. Carol Chen — Review PRs within 24 hours going forward\r\n\u001b[0m"]
[8.33007, "o", "\u001b[0;31m\u001b[2m    ^^^^ 5 phantom items — different set from Run 1\u001b[0m\r\n"]
