[10.939018, "o", "\r\n\u001b[0;31m\u001b[1m  3 runs → 3 different answers · unstructured prose · invents 3–5 phantom action items\r\n\u001b[0m"]
[10.939027, "o", "\u001b[2m"]
[10.939079, "o", "  (json_only arm: 10/10 valid JSON — but STILL 0/10 exact. Format alone doesn't fix scope.)\r\n\u001b[0m"]
[13.940883, "o", "\u001b[2J\u001b[H\r\n\u001b[0;32m  ▶ ACT 2  —  openSOP (process file)\u001b[0m\r\n\r\n"]
[13.940908, "o", "\u001b[2m  Process: cli/bench/processes/extract-action-items.sop.json\u001b[0m\r\n\u001b[2m  Key additions: scope rule (ACTION ITEMS heading only) + strict JSON schema\u001b[0m\r\n\r\n"]
[13.941008, "o", "\u001b[0;36m  $ opensop run extract-action-items.sop.json\u001b[0m\r\n"]
