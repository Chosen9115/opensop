#!/usr/bin/env bash
# OpenSOP pre-commit hook — scans staged changes for secrets via gitleaks.
#
# Installed by `bin/install-git-hooks`. The same scan runs in CI on every
# PR (.github/workflows/secret-scan.yml), so this is fast local feedback
# rather than the source of truth.
#
# Bypass with `git commit --no-verify` when you're certain (e.g. committing
# a known fixture). CI will still catch genuine secrets at PR time.

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
[pre-commit] gitleaks not installed — skipping secret scan.

Install: brew install gitleaks  (or see https://github.com/gitleaks/gitleaks)
CI will still scan this commit at PR time.
EOF
  exit 0
fi

# `gitleaks protect --staged` scans only what's about to be committed.
# Returns 1 if a secret is detected; 0 otherwise.
if ! gitleaks protect --staged --redact --no-banner --config .gitleaks.toml 2>&1; then
  cat >&2 <<'EOF'

[pre-commit] gitleaks found a potential secret in your staged changes.

Review the report above. If it's a real secret:
  1. Remove it from the file (and rotate it if it's been exposed elsewhere).
  2. `git add` the cleaned file and re-commit.

If it's a false positive (test fixture, documented placeholder), add an
allowlist entry to .gitleaks.toml and re-commit.

To bypass for a single commit (use sparingly):
  git commit --no-verify
EOF
  exit 1
fi

exit 0
